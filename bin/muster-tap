#!/usr/bin/env python3
"""
muster-tap — run a program under a pty that turns OSC 7501 reports into
muster session records.

    muster-tap [--agent <id>] [--session <id>] -- <command> [args...]

Muster speaks the Program Status Protocol (OSC 7501):
https://www.superlogical.com/rex/docs/build/program-status

Every other writer in this plugin needs the agent to call it. This one does
not: it is a pty filter, the way `script(1)` is. It runs the command on a
pseudo-terminal, forwards every byte unchanged to the real terminal, and when
it sees an OSC 7501 report in the stream it writes that report as a record.
That makes any program which already speaks OSC 7501 — no hook, no
per-agent code — a first-class session to the widget.

It answers the spec's feature-detection query (`OSC 7501;?`) itself, so a
program that asks before it reports starts reporting even under a terminal
that does not answer. The query is still forwarded, so a terminal that does
answer is not silenced either.

One tap owns several records at once: every report is filed under its
protocol id, and the empty id is the root record. `state=clear` removes the
addressed record and every record below it, a root clear removes every record
of this tap, and a new shell prompt (OSC 133 `A`) or the exit of the child
drops the records that are still running — `done` and `error` survive both.

It is deliberately a per-session wrapper, not a daemon: nothing runs in the
background, and nothing listens on a socket. It writes the records itself,
in this file, with the Python standard library only: no writer process, no
shell pipeline, no lock file, no jq. A record is written to a staging file
in the sessions directory and renamed onto its final
name, so a reader never sees half a record. The sessions directory is opened
once, with O_NOFOLLOW, and every write and every removal goes through that
descriptor: a same-user process that renames the directory or plants a
symlink at any component of the path cannot redirect a record.

If the sessions directory cannot be opened the tap says so once and keeps
relaying the bytes: a broken state directory must not cost the user their
terminal.

A tap is a filter, so it has to survive whatever runs under it. A few rules
keep that true:

  * The pty master is not blocking. A child that never reads its stdin fills
    the pty queue, and a blocking write there would freeze the tap — and with
    it the terminal it is in front of. Every write goes through `write_all`,
    which waits out a short write instead of dropping the rest.
  * A record is written where the report is read, because the write is
    cheap: one small file and one rename. A rate cap keeps a program that
    reports in a burst from turning the tap into a file-system benchmark; the
    staging file is renamed, not fsynced, so a report does not wait for disk.
  * The registry of records is bounded at 64 (the spec's minimum; 256 is the
    maximum); the least recently updated record is evicted when it is full,
    and every file the tap owns is removed when it exits.
  * The name of a record always carries a digest of the protocol id, and
    every tap carries a random token in its names, so one program cannot
    address — or delete — the record of another.

This script is the only writer in this branch. An agent that does not speak
OSC 7501 itself is not a session here.
"""

import base64
import binascii
import fcntl
import hashlib
import json
import os
import pty
import queue
import re
import resource
import secrets
import select
import signal
import stat
import struct
import subprocess
import sys
import termios
import threading
import time
import tty

OSC_7501_PREFIX = b"\x1b]7501;"
OSC_133_PREFIX = b"\x1b]133;"
MAX_BODY = 4096  # the spec caps a whole sequence at 4096 bytes

# The feature probe, answered as a terminal would (spec rev 0.4): the states
# this consumer understands and the kinds a blocked report may carry.
PROBE_REPLY = (b"\x1b]7501;?:states=idle,working,done,blocked,error"
               b":kinds=permission,question,auth\x1b\\")

# The states a report may carry. `clear` is a command, never a stored state,
# and a report without a state (or with a state the spec does not define) is
# ignored — the spec never says "assume working".
STATES = {"idle", "working", "done", "blocked", "error"}
# `done` and `error` are settled: they survive the exit of the child and a
# new shell prompt, so the user finds the result.
SETTLED = {"done", "error"}
# `working` and `blocked` are live: a new shell prompt means the run is over.
LIVE = {"working", "blocked"}
# The kinds a blocked report may carry. An unknown kind is absent, not a
# reason to drop the report.
KINDS = {"permission", "question", "auth"}

# The wire grammar of the spec: a key is 1..16 lowercase letters, a value is
# made of the characters below. Whitespace around a key or a value is trimmed,
# but whitespace inside a value is not part of the charset, so such a pair is
# malformed and is skipped.
KEY_RE = re.compile(r"^[a-z]{1,16}$")
VALUE_RE = re.compile(r"^[A-Za-z0-9_.,+/=-]*$")
# A record id is hierarchical: at most 8 levels of at most 32 characters,
# which is 263 characters in all (8 x 32 + 7 separators).
ID_RE = re.compile(r"^[A-Za-z0-9_.+-]{1,32}(?:/[A-Za-z0-9_.+-]{1,32}){0,7}$")
MAX_ID_LEN = 263
# The shape an agent or a session id is held to: letters, digits, dot, dash,
# underscore. The file name of a record carries the session, so a session has
# to be a plain token.
ID_SHAPE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")

# The tap trims ASCII whitespace around a key and a value. Python's
# `str.strip()` would also trim Unicode spaces, so the tap could accept a
# pair the spec does not — the two would then disagree about the report.
# Only the characters below are whitespace here.
ASCII_WS = " \t\r\n\v\f"
ASCII_WS_BYTES = ASCII_WS.encode("ascii")

# The spec's limits for the free text of a report: the encoded value and the
# decoded text. A value that is over its limit discards the whole report.
MAX_TITLE_ENC = 256
MAX_TITLE_DEC = 192
MAX_MSG_ENC = 2732
MAX_MSG_DEC = 2048
# The caps of the record itself. They are the spec's own limits, so a
# conforming report is never cut short.
MAX_NAME = 192
MAX_MESSAGE = 2048
MAX_AGENT = 32
MAX_SESSION = 64
MAX_CWD = 1024
MAX_PROJECT = 256
# A control character in the text of a report is a forgery attempt, not a
# line break: the spec forbids the C0 range, DEL and the C1 range.
CONTROL_RE = re.compile(r"[\x00-\x1f\x7f-\x9f]")

# The spec requires at least 64 records per terminal and allows a lower cap.
# 64 is plenty for a tap's children, and it bounds the exit cleanup: every
# live record costs one removal there. The oldest record is evicted.
MAX_RECORDS = 64
# One read can hold thousands of minimal sequences; parsing all of them in
# one tick is a CPU amplifier. The rest of the read is dropped: a normal
# agent never approaches this, and the registry is capped well below it.
MAX_EVENTS_PER_READ = 32
# A tap answers a bounded number of feature queries. A program that asks in a
# loop must not be able to make the tap write to the pty forever.
PROBE_LIMIT = 32
# How long the answer to a feature query may wait for room in the pty.
PROBE_TIMEOUT = 0.05
# How long the user input may wait for room in the pty before it is dropped.
# Normal input never waits; only a child that stopped reading its stdin does.
INPUT_TIMEOUT = 0.1
# The rate at which records may be written. A direct write is cheap, but a
# child that reports in a loop must not be able to turn the tap into a
# file-system benchmark. The bucket is per tap, and a report that does not
# fit is dropped: the next report of that id replaces the file anyway.
WRITE_RATE = 64.0
WRITE_BURST = 64.0
# How long the relay waits for the pty when nothing happens. The clock moves
# on even when there is nothing to do, so the relay never spins.
RELAY_TIMEOUT = 0.2


def fail(message):
    print(f"muster-tap: {message}", file=sys.stderr)
    sys.exit(2)


def now():
    return time.monotonic()


# ------------------------------------------------------------- the store

class StoreError(Exception):
    """The sessions directory is not usable."""


def state_base():
    """The state home: XDG_STATE_HOME, else ~/.local/state.

    XDG wants an absolute path. A relative one would put the records next to
    wherever the tap happens to run, and one that starts with a dash is
    read as an option by everything that touches a path.
    """
    base = os.environ.get("XDG_STATE_HOME", "")
    if not base:
        home = os.environ.get("HOME", "")
        if not home:
            raise StoreError("neither XDG_STATE_HOME nor HOME is set")
        base = os.path.join(home, ".local", "state")
    if not os.path.isabs(base):
        raise StoreError(f"the state home must be an absolute path: {base}")
    trimmed = base.rstrip("/")
    return trimmed or "/"


def sanitize(value, cap):
    """A plain, path-safe token: the shape of a file name component.

    Everything outside `[A-Za-z0-9._-]` becomes an underscore and the result
    is cut to `cap` characters. The file name of a record is
    `agent~session.json`, so both parts have to survive this.
    """
    token = re.sub(r"[^A-Za-z0-9._-]", "_", str(value or ""))
    return token[:cap]


def record_name(agent, session):
    """The name of the file of a record."""
    return f"{sanitize(agent, MAX_AGENT)}~{sanitize(session, MAX_SESSION)}.json"


class RecordStore:
    """The sessions directory of the plugin, opened once and kept open.

    Every record is written and removed through the descriptor of this
    directory, so a same-user process that renames the directory or plants a
    symlink at any component of the path cannot redirect a record: the
    descriptor addresses the inode that was vetted when the tap started.

    The chain under the state home is created with mode 0700 and every
    component is refused when it is a symlink, not a directory or not owned
    by this user. The state home itself is left alone: a user who symlinks
    XDG_STATE_HOME into a dotfiles repo did that on purpose.
    """

    def __init__(self, base=None):
        self.base = base
        self.path = None
        self.fd = None

    # ------------------------------------------------------------- setup

    def open(self):
        """Open the sessions directory; raise StoreError when it is unsafe.

        Each component is created and opened relative to its parent's
        descriptor with O_NOFOLLOW, then chmod'ed through that descriptor.
        There is no path chmod and no window in which a symlink planted at an
        intermediate component can redirect the setup.
        """
        base = self.base or state_base()
        self.base = base
        self._prepare_base(base)
        try:
            fd = os.open(base, os.O_RDONLY | os.O_DIRECTORY)
        except OSError as error:
            raise StoreError(f"cannot open {base}: {error}")
        path = base
        try:
            for part in ("omarchy", "muster", "sessions"):
                path = os.path.join(path, part)
                child = self._enter(fd, part)
                try:
                    os.close(fd)
                except OSError:
                    pass
                fd = child
            info = os.fstat(fd)
            mode = stat.S_IMODE(info.st_mode)
            if mode != 0o700:
                raise StoreError(f"{path} is mode {mode:o}, not 700; refusing")
            try:
                on_disk = os.stat(path, follow_symlinks=False)
            except OSError as error:
                raise StoreError(f"{path}: {error}")
            if stat.S_ISLNK(on_disk.st_mode):
                raise StoreError(f"{path} is a symlink; refusing")
            if (on_disk.st_dev, on_disk.st_ino) != (info.st_dev, info.st_ino):
                raise StoreError(f"{path} changed while it was being opened")
        except BaseException:
            try:
                os.close(fd)
            except OSError:
                pass
            raise
        self.path = path
        self.fd = fd
        return self

    def _enter(self, parent_fd, part):
        """Create/open one component under `parent_fd`, no symlink following."""
        try:
            os.mkdir(part, 0o700, dir_fd=parent_fd)
        except FileExistsError:
            pass
        except OSError as error:
            raise StoreError(f"cannot create {part}: {error}")
        try:
            fd = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                         dir_fd=parent_fd)
        except OSError as error:
            raise StoreError(f"cannot open {part}: {error}")
        try:
            info = os.fstat(fd)
            if not stat.S_ISDIR(info.st_mode):
                raise StoreError(f"{part} is not a directory")
            if info.st_uid != os.getuid():
                raise StoreError(f"{part} is not owned by this user")
            try:
                os.fchmod(fd, 0o700)
            except OSError:
                pass
            mode = stat.S_IMODE(os.fstat(fd).st_mode)
            if mode != 0o700:
                raise StoreError(f"{part} is mode {mode:o}, not 700; refusing")
        except BaseException:
            os.close(fd)
            raise
        return fd

    def close(self):
        """Give the directory back; the tap is done with it."""
        if self.fd is not None:
            try:
                os.close(self.fd)
            except OSError:
                pass
            self.fd = None

    @staticmethod
    def _prepare_base(base):
        """The state home has to be a directory; a symlink there is allowed."""
        try:
            info = os.stat(base)
        except FileNotFoundError:
            try:
                os.mkdir(base, 0o700)
            except OSError as error:
                raise StoreError(f"cannot create {base}: {error}")
            info = os.stat(base)
        except OSError as error:
            raise StoreError(f"{base}: {error}")
        if not stat.S_ISDIR(info.st_mode):
            raise StoreError(f"{base} is not a directory")

    # ------------------------------------------------------------- write

    def write(self, agent, session, record):
        """Publish one record; the file is replaced, never appended to.

        The record is written to a staging file and renamed onto its final
        name, so a reader sees either the old record
        or the new one and never a half-written file.
        """
        if self.fd is None:
            return False
        name = record_name(agent, session)
        try:
            payload = json.dumps(record, separators=(",", ":"),
                                 ensure_ascii=False)
        except (TypeError, ValueError):
            return False
        data = payload.encode("utf-8", "replace")
        # A fresh name every time, created with O_EXCL: a name that already
        # exists — including one planted as a hardlink — makes the open fail
        # instead of being followed or truncated.
        staging = f".muster.{secrets.token_hex(8)}.tmp"
        try:
            fd = os.open(staging, os.O_WRONLY | os.O_CREAT | os.O_EXCL
                         | os.O_NOFOLLOW, 0o600, dir_fd=self.fd)
        except OSError:
            return False
        try:
            os.fchmod(fd, 0o600)
        except OSError:
            self._discard(staging)
            os.close(fd)
            return False
        try:
            view = memoryview(data)
            while view:
                written = os.write(fd, view)
                if written <= 0:
                    raise OSError("short write")
                view = view[written:]
            mode = stat.S_IMODE(os.fstat(fd).st_mode)
        except OSError:
            self._discard(staging)
            return False
        finally:
            try:
                os.close(fd)
            except OSError:
                pass
        if mode != 0o600:
            # The file was created with mode 0600; a filesystem that ignores
            # POSIX modes would leave the record readable by every local
            # user, so it is not published.
            self._discard(staging)
            return False
        try:
            os.replace(staging, name, src_dir_fd=self.fd, dst_dir_fd=self.fd)
        except OSError:
            self._discard(staging)
            return False
        return True

    def remove(self, agent, session):
        """Take one record off the disk."""
        if self.fd is None:
            return False
        name = record_name(agent, session)
        try:
            os.unlink(name, dir_fd=self.fd)
        except OSError:
            return False
        return True

    def _discard(self, staging):
        """Take a staging file away; it never becomes a record."""
        if self.fd is None:
            return
        try:
            os.unlink(staging, dir_fd=self.fd)
        except OSError:
            pass



# ------------------------------------------------------------------ output

def wait_writable(fd, timeout):
    """Wait until `fd` takes bytes again, at most `timeout` seconds."""
    if timeout is None:
        timeout = 0.25
    elif timeout < 0:
        timeout = 0.0
    try:
        _readable, writable, _exceptional = select.select([], [fd], [], timeout)
    except (OSError, InterruptedError):
        return False
    return bool(writable)


def write_all(fd, data, timeout=None):
    """Write every byte of `data` to `fd`.

    A write can be short — a pipe or a pty that is full takes what it can —
    and a descriptor in non-blocking mode refuses the write outright. Both
    are waited out here, so no byte is dropped: the data goes out whole or
    the function gives up and says so. `timeout` bounds the waiting; without
    one the write waits as long as it takes.
    """
    view = memoryview(data)
    deadline = None if timeout is None else now() + timeout
    while view:
        try:
            written = os.write(fd, view)
        except InterruptedError:
            continue
        except BlockingIOError:
            if deadline is None:
                remaining = 0.25
            else:
                remaining = deadline - now()
                if remaining <= 0:
                    return False
            if not wait_writable(fd, remaining):
                if deadline is None:
                    continue
                return False
            continue
        except OSError:
            return False
        if written <= 0:
            return False
        view = view[written:]
    return True


class Output:
    """A bounded writer thread for the real terminal.

    A blocking os.write(stdout) can sit in the kernel when the terminal or a
    pipe stops draining; doing it on the relay thread would freeze parsing,
    input and cleanup, and SIGTERM could not break it. The relay only enqueues;
    this daemon thread drains the queue. When the queue is full the newest
    chunk is dropped, so the prefix of the stream stays intact; a slow reader
    may still lose a tail, but it cannot make the relay block.
    """

    def __init__(self, fd):
        self.fd = fd
        self.queue = queue.Queue(maxsize=256)
        self.thread = None
        if fd is not None:
            self.thread = threading.Thread(target=self.run, daemon=True)
            self.thread.start()

    def write(self, data):
        if self.thread is None or not data:
            return
        try:
            self.queue.put_nowait(data)
        except queue.Full:
            # Drop the *new* chunk, not the oldest: a hole in the middle of
            # an escape sequence corrupts the terminal more than a truncated
            # tail. The reader is not draining; backpressure belongs to the
            # pty, which the child already feels.
            pass

    def run(self):
        while True:
            data = self.queue.get()
            if data is None:
                return
            write_all(self.fd, data)

    def close(self, timeout=2.0):
        if self.thread is None:
            return
        try:
            self.queue.put_nowait(None)
        except queue.Full:
            try:
                self.queue.get_nowait()
                self.queue.put_nowait(None)
            except (queue.Empty, queue.Full):
                pass
        self.thread.join(timeout)


def read_some(fd):
    """Read what is there. `b""` is "nothing right now", `None` is the end."""
    try:
        return os.read(fd, 65536)
    except InterruptedError:
        return b""
    except BlockingIOError:
        return b""
    except OSError:
        return None


def read_input(fd):
    """Read the user input. `None` is the end of the input or an error.

    A blocking descriptor returns an empty read only at the end of the file;
    a non-blocking one returns it when there is nothing right now, and then
    the input is not over.
    """
    try:
        data = os.read(fd, 65536)
    except InterruptedError:
        return b""
    except BlockingIOError:
        return b""
    except OSError:
        return None
    if data:
        return data
    # A readable descriptor that returns no bytes is at EOF (a non-blocking
    # EAGAIN raises BlockingIOError above). Treat it as the end either way,
    # or select would keep reporting it readable and the relay would spin.
    return None


# --------------------------------------------------------------- the wire

class Scanner:
    """Watch a byte stream for the sequences Muster cares about.

    The bytes are forwarded to the terminal regardless; this only watches them.
    A sequence split across reads is held until its terminator arrives, and a
    partial prefix at the end of a read is kept for the next one. The two
    sequences are an OSC 7501 report and the OSC 133 `A` prompt marker, which
    is terminated by BEL or by ST like every other OSC sequence.

    The scan runs over indexes, not over slices: the buffer is searched from
    the last position and compacted once per read, so a long stream costs
    time proportional to its length and not to its length squared.
    """

    def __init__(self):
        self.buf = b""

    def feed(self, data):
        events = []
        if data:
            self.buf += data
        buf = self.buf
        size = len(buf)
        pos = 0
        keep = max(len(OSC_7501_PREFIX), len(OSC_133_PREFIX)) - 1
        at7501 = buf.find(OSC_7501_PREFIX, pos)
        at133 = buf.find(OSC_133_PREFIX, pos)
        if at7501 < 0:
            at7501 = size
        if at133 < 0:
            at133 = size
        while pos < size:
            # The two finds are cached: re-searching the whole remaining
            # buffer for the prefix that is not present made this quadratic
            # on a 64 KiB read (measured 51 ms vs 2 ms).
            if at7501 < pos:
                at7501 = buf.find(OSC_7501_PREFIX, pos)
                if at7501 < 0:
                    at7501 = size
            if at133 < pos:
                at133 = buf.find(OSC_133_PREFIX, pos)
                if at133 < 0:
                    at133 = size
            if at7501 == size and at133 == size:
                # No sequence in sight: keep only a tail that could still grow
                # into one.
                if size - pos > keep:
                    pos = size - keep
                break
            if at7501 == size:
                start, kind = at133, "133"
            elif at133 == size:
                start, kind = at7501, "7501"
            elif at7501 <= at133:
                start, kind = at7501, "7501"
            else:
                start, kind = at133, "133"
            prefix = OSC_7501_PREFIX if kind == "7501" else OSC_133_PREFIX
            body_start = start + len(prefix)
            # Bound the terminator search to one legal body. A stray prefix
            # with no terminator must not swallow the next legitimate report.
            limit = body_start + MAX_BODY + 1
            bel = buf.find(b"\x07", body_start, limit)
            st = buf.find(b"\x1b\\", body_start, limit)
            c1 = buf.find(b"\x9c", body_start, limit)
            ends = [end for end in (bel, st, c1) if end != -1]
            if not ends:
                if size - body_start > MAX_BODY:
                    # An unterminated body over the cap: drop the rest of this
                    # read. Resyncing at the next prefix would re-scan the
                    # same 4 KiB window for every 7-byte prefix and turn a
                    # 64 KiB read into a CPU amplifier.
                    pos = size
                    break
                # Wait for the rest of the sequence; keep what we have.
                pos = start
                break
            end = min(ends)
            if end - body_start > MAX_BODY:
                pos = end + (2 if end == st else 1)
                continue
            # A stray prefix (for example inside a window-title OSC) must not
            # swallow the next real report. A legal body cannot contain a
            # nested OSC prefix — the value charset excludes ESC — so the
            # inner prefix is the start of the next sequence.
            nested7501 = buf.find(OSC_7501_PREFIX, body_start, end)
            nested133 = buf.find(OSC_133_PREFIX, body_start, end)
            nested = [at for at in (nested7501, nested133) if at != -1]
            if nested:
                pos = min(nested)
                continue
            body = bytes(buf[body_start:end])
            pos = end + (2 if end == st else 1)
            if kind == "7501":
                events.append(("7501", body))
            elif body[:1] == b"A":
                # OSC 133 `A` is a new shell prompt: whatever was running is
                # over.
                events.append(("prompt", body))
            if len(events) >= MAX_EVENTS_PER_READ:
                # Bound the work one read can create; drop the rest.
                pos = size
                break
        # Everything before `pos` was forwarded already; only the tail is
        # kept for the next read.
        self.buf = buf[pos:]
        return events


def parse_pairs(body):
    """The protocol's key=value list, parsed defensively.

    A key that is not 1..16 lowercase letters is not a key at all, and a
    value outside the wire charset makes its pair malformed; both are skipped.
    A repeated key keeps the last value, and whitespace around a key or a
    value is trimmed — but never inside a value, because a space is outside
    the charset and the pair is malformed anyway. Only ASCII whitespace is
    trimmed, so the tap never reads as a pair the spec does not allow.

    A malformed *id* is worse than a malformed other pair: dropping it would
    turn the report into an id-less (root) report, so the whole report is
    marked bad and dropped.
    """
    pairs = {}
    bad_id = False
    # surrogateescape keeps an undecodable byte in the value, where the
    # charset check rejects the pair, instead of failing the whole body.
    text = body.decode("utf-8", "surrogateescape")
    for chunk in text.split(":"):
        if "=" not in chunk:
            continue
        key, _, value = chunk.partition("=")
        key = key.strip(ASCII_WS)
        value = value.strip(ASCII_WS)
        if not KEY_RE.fullmatch(key):
            continue
        if not VALUE_RE.fullmatch(value):
            if key == "id":
                bad_id = True
            continue
        pairs[key] = value
    return pairs, bad_id


def decode_text(encoded, max_encoded, max_decoded):
    """Decode a free-text value of a report.

    The spec's rule is all-or-nothing: a value that does not decode, that
    decodes to a control character or that is over its limit is not a text,
    and the report that carries it is discarded. `None` means that.
    """
    if not encoded:
        return ""
    if len(encoded) > max_encoded:
        return None
    # The padding is optional on the wire.
    padded = encoded + "=" * (-len(encoded) % 4)
    try:
        raw = base64.b64decode(padded, validate=True)
    except (binascii.Error, ValueError):
        return None
    if len(raw) > max_decoded:
        return None
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        return None
    if CONTROL_RE.search(text):
        return None
    return text


def valid_app(value):
    """The spec's app grammar: [A-Za-z0-9_.+-]{1,32}."""
    return bool(re.fullmatch(r"[A-Za-z0-9_.+-]{1,32}", value or ""))


def safe_agent(value, fallback="agent"):
    """An agent id: plain characters only, and short."""
    value = re.sub(r"[^A-Za-z0-9._-]", "_", str(value or ""))
    value = re.sub(r"^[^A-Za-z0-9]+", "", value)
    return (value or fallback)[:MAX_AGENT]


def session_token(value, budget):
    """A plain token for a protocol id, with a digest that is always there.

    The digest is ALWAYS appended: sanitising maps a `/` to a `_` and a long
    id is cut short, so a token alone is not unique. Worse, a lossy token can
    be spelled out by hand — `a_b-1a2b3c4d` is a legal id — and it would
    then name the file of `a/b`, so one program could delete the record of
    another. With the digest always there, two different ids never share a
    file.
    """
    token = re.sub(r"[^A-Za-z0-9._-]", "_", str(value or ""))
    digest = hashlib.blake2b(str(value).encode("utf-8", "replace"),
                             digest_size=8).hexdigest()
    suffix = "-" + digest
    room = budget - len(suffix)
    if room < 1:
        room = 1
    return token[:room] + suffix


def valid_id(value):
    """The spec's id grammar: 263 characters in all, 32 per level, 8 levels."""
    if not value or len(value) > MAX_ID_LEN:
        return False
    return bool(ID_RE.fullmatch(value))


def project_name(cwd):
    """The project of a working directory: its last component."""
    trimmed = (cwd or "").rstrip("/")
    if not trimmed:
        return ""
    return trimmed.rsplit("/", 1)[-1]


def tmux_socket(value):
    """A tmux socket is an absolute path of plain segments.

    The socket is passed to tmux as data, but a traversal path would still
    select an arbitrary socket, so it is dropped rather than stored.
    """
    if not re.fullmatch(r"/[A-Za-z0-9._/-]{1,255}", value or ""):
        return ""
    if any(part in ("", ".", "..") for part in value.split("/")[1:]):
        return ""
    return value


def environment_panes():
    """The multiplexer panes of this terminal.

    tmux injects TMUX_PANE and TMUX into every pane; both are read only when
    the pane id has the shape tmux writes, so a stray environment cannot put
    an arbitrary value into a record.
    """
    herdr = ""
    if os.environ.get("HERDR_ENV") == "1":
        candidate = os.environ.get("HERDR_PANE_ID", "")
        if re.fullmatch(r"[A-Za-z0-9:_.-]{0,64}", candidate):
            herdr = candidate
    pane = ""
    socket = ""
    candidate = os.environ.get("TMUX_PANE", "")
    if re.fullmatch(r"%\d{1,6}", candidate):
        pane = candidate
        socket = tmux_socket(os.environ.get("TMUX", "").split(",", 1)[0])
    return herdr, pane, socket


# -------------------------------------------------------------- the tap

class Tap:
    """The receiver: the records of one tap, fed by the OSC 7501 wire.

    Every report is filed under its protocol id; the empty id is the root
    record. The registry is per tap, so a program that reports several ids
    owns several records at once and each of them keeps its own lifetime.

    A report is written where it is read: the write is a small file and one
    rename, so there is no writer process, no queue and no lock to hold. A
    rate cap keeps a program that
    reports in a burst from turning the tap into a file-system benchmark.
    """

    def __init__(self, pid, store, agent="", session="", master_fd=None,
                 token=None, window="", cwd=None, herdr_pane=None,
                 tmux_pane=None, tmux_socket_value=None):
        self.pid = pid
        self.store = store
        self.agent = agent
        self.session = session
        self.master_fd = master_fd
        # A random token in every name: a pid can be reused, and a later tap
        # must not adopt — or delete — the records of an earlier one.
        self.token = token or secrets.token_hex(8)
        self.window = window if re.fullmatch(r"0x[0-9a-fA-F]{1,16}",
                                             window or "") else ""
        self.cwd = cwd if cwd is not None else safe_cwd()
        self.terminal_id = f"tap:{pid}:{self.token}"
        self.session_prefix = f"tap-{pid}-{self.token}"
        self.records = {}  # id -> {"state", "agent", "session", "record_id"}
        self.apps = {}  # id -> the app last seen for that id
        self.scanner = Scanner()
        self.order = 0  # the counter that says which record is the oldest
        self.probes = 0  # the feature queries answered so far
        self.tokens = WRITE_BURST
        self.tokens_at = now()
        self.warned = False
        panes = environment_panes()
        self.herdr_pane = panes[0] if herdr_pane is None else herdr_pane
        self.tmux_pane = panes[1] if tmux_pane is None else tmux_pane
        self.tmux_socket = panes[2] if tmux_socket_value is None \
            else tmux_socket_value
        if master_fd is not None:
            # The master is not blocking: a child that never reads its stdin
            # fills the pty queue, and a blocking write there would freeze
            # the tap and the terminal with it.
            try:
                os.set_blocking(master_fd, False)
            except OSError:
                pass

    # ------------------------------------------------------------- wire

    def feed(self, data):
        """Watch the stream: publish the reports, drop the stale records."""
        for kind, body in self.scanner.feed(data):
            if kind == "prompt":
                self.drop_live()
            else:
                self.handle_body(body)

    def handle_body(self, body):
        # The cap is checked first: a sequence that is too long is dropped
        # whole, and it is not a feature query either.
        if len(body) > MAX_BODY:
            return
        # A NUL cannot live in a shell variable and cannot be part of a
        # report: the whole sequence is dropped.
        if b"\x00" in body:
            return
        if body.strip(ASCII_WS_BYTES) == b"?":
            # Feature detection: the whole body is `?`. Answer as the terminal
            # would, so a program that asks before it reports starts
            # reporting. The query itself is still forwarded to the real
            # terminal, which may answer it as well.
            self.answer_probe()
            return
        pairs, bad_id = parse_pairs(body)
        if bad_id:
            return
        state = pairs.get("state", "")
        record_id = pairs.get("id", "")
        # An absent id is the root record; an explicit empty id is not the
        # same thing. Both a broken and an empty id are discarded whole: they
        # must not fall back to (and overwrite or clear) the root record.
        if "id" in pairs and not valid_id(record_id):
            return
        if state == "clear":
            # `clear` is a command, not a state: it removes records and never
            # writes one. Without an id it addresses the root.
            self.clear(record_id)
            return
        if state not in STATES:
            # No state at all, or a state the spec does not define.
            return
        # The free text is all-or-nothing: a title or a message that does not
        # decode, that decodes to a control character or that is over the
        # spec's limit discards the whole report. Keeping the state and
        # dropping only the text would publish a claim the program never made.
        title = decode_text(pairs.get("title", ""), MAX_TITLE_ENC, MAX_TITLE_DEC)
        if title is None:
            return
        message = decode_text(pairs.get("msg", ""), MAX_MSG_ENC, MAX_MSG_DEC)
        if message is None:
            return
        # An unknown kind and a progress that is not an integer in 0..100 are
        # absent: the spec says so, and they do not invalidate the rest of
        # the report. A kind only means something for a blocked report.
        kind = pairs.get("kind", "") if state == "blocked" else ""
        if kind not in KINDS:
            kind = ""
        progress = -1
        if state in ("working", "blocked"):
            raw = pairs.get("progress", "")
            if re.fullmatch(r"(?:0|[1-9][0-9]|100)", raw):
                progress = int(raw)
        agent = self.resolve_agent(record_id, pairs.get("app", ""))
        session = self.resolve_session(record_id)
        previous = self.records.get(record_id)
        if previous is not None and previous["agent"] != agent:
            # The app of this id changed, so the record moves to another file
            # (the name of a record is agent + session): the old one is taken
            # off the disk, or it would stay behind forever.
            self.remove(previous)
        if self.publish(agent, session, record_id, state, title, message,
                        kind, progress):
            # Only a record that reached the disk may evict another one.
            self.make_room(record_id)
            self.remember(record_id, state, agent, session)

    def answer_probe(self):
        """Answer the feature query, as far as the pty allows.

        The answer is best effort: the master is not blocking, the pty may be
        full because the child does not read its stdin, and a tap answers a
        bounded number of queries.
        """
        if self.master_fd is None:
            return
        if self.probes >= PROBE_LIMIT:
            return
        self.probes += 1
        write_all(self.master_fd, PROBE_REPLY, timeout=PROBE_TIMEOUT)

    # --------------------------------------------------------- identities

    def resolve_agent(self, record_id, app):
        """The agent a record is filed under.

        `--agent` is an explicit override: when the user names an agent on
        the command line, that name wins over the `app` the program reports,
        and it is the fallback when nothing else is known. Without it, the
        app comes from the report, and a report that carries no app inherits
        the app of the nearest ancestor that has one — its own remembered app
        first, then the parent, then the root.
        """
        # An app outside the spec's grammar is absent, not a reason to drop
        # the report; the record then falls back to an inherited app or the
        # agent the tap was started with.
        if app and not valid_app(app):
            app = ""
        if app:
            self.remember_app(record_id, app)
        if self.agent:
            return safe_agent(self.agent)
        if app:
            return safe_agent(app)
        for candidate in self.ancestry(record_id):
            known = self.apps.get(candidate)
            if known:
                return safe_agent(known)
        return "agent"

    def remember_app(self, record_id, app):
        """Keep the app of an id, in a bounded table."""
        self.apps.pop(record_id, None)
        self.apps[record_id] = app
        while len(self.apps) > MAX_RECORDS:
            oldest = next(iter(self.apps))
            del self.apps[oldest]

    def resolve_session(self, record_id):
        """The file name of a record.

        The root record is named after the tap (`tap-<pid>-<token>`) and a
        child record after the tap and its id (`tap-<pid>-<token>-<safe id>`),
        so the records of one tap never collide. An explicit `--session`
        prefixes every name; the id digest still keeps each id in its own
        file, so one id's exit removal cannot delete another id's record.
        """
        if self.session:
            # Namespace the explicit name by the tap token: the child controls
            # app=, and an un-namespaced `--session work` would let it claim
            # `app=claude` and overwrite claude~work. Keep the id digest too:
            # collapsing every id onto one file loses a report and lets a
            # live record's exit removal delete a settled one. Leave room for
            # the digest and the separator so the name is never over 64.
            token_part = f"-{self.token}"
            keep = 64 - 18 - 1 - len(token_part)
            base = f"{self.session[:max(1, keep)]}{token_part}"
            if not record_id:
                return base
            budget = 64 - len(base) - 1
            return f"{base}-{session_token(record_id, budget)}"
        prefix = self.session_prefix
        budget = 64 - len(prefix) - 1
        if budget < 18:
            prefix = prefix[:64 - 18 - 1]
            budget = 64 - len(prefix) - 1
        if not record_id:
            return prefix
        return f"{prefix}-{session_token(record_id, budget)}"

    @staticmethod
    def ancestry(record_id):
        """The record itself, then its ancestors, nearest first, then the root."""
        if not record_id:
            return [""]
        parts = record_id.split("/")
        chain = ["/".join(parts[:i]) for i in range(len(parts), 0, -1)]
        chain.append("")
        return chain

    # ----------------------------------------------------------- records

    def publish(self, agent, session, record_id, state, title, message,
                kind, progress):
        """Write the record of one id; the file is replaced, never appended.

        The record holds the whole report: there is no merge with a previous
        record, so a report without a title or a message writes an empty name
        and an empty message rather than keeping the text of an older run.
        Each report also refreshes `updatedAt`, which is the heartbeat the
        reader's 120 s staleness clock needs.
        """
        if not self.allow_write():
            return False
        record = {
            "schemaVersion": 2,
            "agent": agent[:MAX_AGENT],
            "sessionId": session[:MAX_SESSION],
            "name": title[:MAX_NAME],
            "cwd": self.cwd[:MAX_CWD],
            "project": project_name(self.cwd)[:MAX_PROJECT],
            "state": state,
            "kind": kind,
            "progress": progress,
            "recordId": record_id[:MAX_ID_LEN],
            "message": message[:MAX_MESSAGE],
            "pid": self.pid,
            "windowAddress": self.window,
            "herdrPane": self.herdr_pane,
            "tmuxPane": self.tmux_pane,
            "tmuxSocket": self.tmux_socket,
            "terminalId": self.terminal_id,
            "updatedAt": int(time.time() * 1000),
        }
        if not self.store.write(record["agent"], record["sessionId"], record):
            self.warn_once("cannot write a record")
            return False
        return True

    def remove(self, record):
        """Take a record off the disk, with the agent and session it had."""
        self.store.remove(record["agent"], record["session"])

    def make_room(self, record_id):
        """Make room for a new record: the oldest one goes when the cap is hit.

        The eviction happens after the new report is written, so a report that
        the rate cap refused does not evict a live record.
        """
        if record_id not in self.records and len(self.records) >= MAX_RECORDS:
            self.evict()

    def remember(self, record_id, state, agent, session):
        """Keep the state of a record."""
        self.order += 1
        self.records[record_id] = {
            "state": state,
            "agent": agent,
            "session": session,
            "record_id": record_id,
            "order": self.order,
        }

    def evict(self):
        """Drop the least recently updated record and take its file away."""
        if not self.records:
            return
        oldest = min(self.records, key=lambda key: self.records[key]["order"])
        record = self.records.pop(oldest)
        self.apps.pop(oldest, None)
        self.remove(record)

    def clear(self, record_id):
        """`state=clear`: remove the addressed record and everything below it.

        A clear without an id addresses the root and therefore removes every
        record of this tap. The records are removed with the agent and the
        session they were filed under, and their app entries go with them, so
        a later report does not inherit an app of a record that is gone. Only
        the files of this tap are touched.
        """
        known = list(self.records)
        known += [key for key in self.apps if key not in self.records]
        if record_id:
            doomed = [key for key in known
                      if key == record_id or key.startswith(record_id + "/")]
        else:
            doomed = known
        for key in doomed:
            record = self.records.pop(key, None)
            if record is not None:
                self.remove(record)
            self.apps.pop(key, None)

    def drop_live(self):
        """A new shell prompt: the runs that were going are over."""
        for key in [k for k, r in self.records.items() if r["state"] in LIVE]:
            record = self.records.pop(key)
            self.apps.pop(key, None)
            self.remove(record)

    def close(self):
        """The child is gone: everything that is not settled is gone with it.

        A `done` or an `error` survives — the user still has to see it — but
        a record that was still running, idle or in an unknown state belongs
        to a process that no longer exists.
        """
        for key in [k for k, r in self.records.items() if r["state"] not in SETTLED]:
            record = self.records.pop(key)
            self.apps.pop(key, None)
            self.remove(record)

    # ------------------------------------------------------------- limits

    def allow_write(self):
        """The rate cap: at most WRITE_RATE records a second, in bursts."""
        elapsed = max(0.0, now() - self.tokens_at)
        self.tokens = min(WRITE_BURST, self.tokens + elapsed * WRITE_RATE)
        self.tokens_at = now()
        if self.tokens < 1.0:
            return False
        self.tokens -= 1.0
        return True

    def warn_once(self, message):
        """Say it once: a broken store must not spam the terminal."""
        if self.warned:
            return
        self.warned = True
        print(f"muster-tap: {message}", file=sys.stderr)


def safe_cwd():
    """The working directory of the tap, or "" when it cannot be read."""
    try:
        return os.getcwd()
    except OSError:
        return ""


# --------------------------------------------------------------- terminal

def winsize(fd):
    try:
        packed = fcntl.ioctl(fd, termios.TIOCGWINSZ, b"\0" * 8)
        rows, cols, xpix, ypix = struct.unpack("HHHH", packed)
        return rows, cols, xpix, ypix
    except OSError:
        return None


def apply_winsize(fd, size):
    if size is None:
        return
    try:
        fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", *size))
    except OSError:
        pass


def close_above_two():
    """Close everything above 2, so the command cannot use the tap's fds.

    The wrapped program would otherwise keep a copy of the real terminal and
    could write to it behind the tap's back, which is exactly what the tap
    exists to prevent. The descriptor of the sessions directory goes with
    them: the child has no business writing records.
    """
    # /proc/self/fd lists only the descriptors that actually exist; closing
    # every number up to a 65k soft limit was 65k syscalls per tap start.
    try:
        for name in os.listdir("/proc/self/fd"):
            try:
                fd = int(name)
            except ValueError:
                continue
            if fd > 2:
                try:
                    os.close(fd)
                except OSError:
                    pass
        return
    except OSError:
        pass
    try:
        _soft, hard = resource.getrlimit(resource.RLIMIT_NOFILE)
    except (OSError, ValueError):
        hard = 256
    if hard <= 0 or hard > 4096:
        hard = 4096
    for fd in range(3, hard):
        try:
            os.close(fd)
        except OSError:
            pass


def reap(pid, grace=1.0):
    """Wait for the child, killing it when it does not go on its own.

    The tap must not leave the program it wraps running behind it, and it
    must not hang on a child that ignores its signals either.
    """
    deadline = now() + grace
    while now() < deadline:
        try:
            waited, status = os.waitpid(pid, os.WNOHANG)
        except ChildProcessError:
            return 0
        if waited == pid:
            return status
        time.sleep(0.02)
    for sig in (signal.SIGTERM, signal.SIGKILL):
        try:
            os.killpg(pid, sig)
        except OSError:
            try:
                os.kill(pid, sig)
            except OSError:
                pass
        try:
            waited, status = os.waitpid(pid, os.WNOHANG)
        except ChildProcessError:
            return 0
        if waited == pid:
            return status
        time.sleep(0.05)
    try:
        _waited, status = os.waitpid(pid, 0)
        return status
    except ChildProcessError:
        return 0


def detect_window():
    """The focused Hyprland window at tap start, or "".

    Resolving it once here means the tap does not have to walk sixteen
    ancestors and call hyprctl again for every new record. A failure simply
    leaves the record without a window address. This is a query of the
    compositor, not a writer: nothing is written anywhere.
    """
    try:
        result = subprocess.run(["hyprctl", "-j", "activewindow"],
                                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                timeout=2, check=False, env=safe_env())
        payload = json.loads(result.stdout or b"{}")
        address = payload.get("address", "") if isinstance(payload, dict) else ""
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return ""
    return address if re.fullmatch(r"0x[0-9a-fA-F]{1,16}", str(address)) else ""


def safe_env():
    """A fixed PATH for the compositor query the tap makes at start.

    The child inherits the user's environment, but the tap must not be able
    to run a `hyprctl` that a writable PATH directory planted. The Muster
    tools live in /usr/bin on Omarchy.
    """
    env = dict(os.environ)
    env["PATH"] = "/usr/bin:/bin"
    env["LC_ALL"] = "C"
    return env


# ----------------------------------------------------------------- main

def main(argv):
    agent = ""
    session = ""
    index = 0
    while index < len(argv):
        arg = argv[index]
        if arg == "--":
            index += 1
            break
        if arg == "--agent":
            index += 1
            if index >= len(argv):
                fail("--agent needs a value")
            agent = argv[index]
        elif arg == "--session":
            index += 1
            if index >= len(argv):
                fail("--session needs a value")
            session = argv[index]
        elif arg in ("-h", "--help"):
            print(__doc__.strip())
            return 0
        elif arg.startswith("-"):
            fail(f"unknown option: {arg}")
        else:
            break
        index += 1

    command = argv[index:]
    if not command:
        fail("no command given; usage: muster-tap [options] -- <command> [args...]")

    if agent and not ID_SHAPE_RE.fullmatch(agent):
        fail("--agent must be an id: letters, digits, dot, dash, underscore (max 64)")
    if session and not ID_SHAPE_RE.fullmatch(session):
        fail("--session must be an id: letters, digits, dot, dash, underscore (max 64)")

    # The store is opened before the child starts. A store that cannot be
    # opened is a warning, not a failure: the tap still relays the bytes,
    # it just does not record anything.
    store = RecordStore()
    try:
        store.open()
    except StoreError as error:
        print(f"muster-tap: {error}; not recording", file=sys.stderr)
        store.close()

    # Resolve the window before the child starts: hyprctl is a synchronous
    # read and must not delay a running child or the relay.
    window = detect_window()

    pid, master = pty.fork()
    if pid == 0:  # child: the command on the pty
        try:
            close_above_two()
            # Mark the child as tap-owned. A Muster integration can stand
            # down on this flag instead of writing a second record.
            os.environ["MUSTER_TAP"] = "1"
            os.execvp(command[0], command)
        except BaseException as error:  # noqa: BLE001 - the child cannot go on
            print(f"muster-tap: cannot run {command[0]}: {error}", file=sys.stderr)
            sys.stderr.flush()
        finally:
            os._exit(127)

    # parent: relay between the real terminal and the pty.
    try:
        stdin_fd = sys.stdin.fileno()
    except (AttributeError, ValueError, OSError):
        stdin_fd = None
    try:
        stdout_fd = sys.stdout.fileno()
    except (AttributeError, ValueError, OSError):
        stdout_fd = None
    # The master is not blocking: a child that never reads its stdin fills
    # the pty queue, and a blocking write there would freeze the tap.
    try:
        os.set_blocking(master, False)
    except OSError:
        pass

    is_tty = stdin_fd is not None and os.isatty(stdin_fd)
    size = winsize(stdout_fd) if stdout_fd is not None else None
    if size is None and stdin_fd is not None:
        size = winsize(stdin_fd)
    apply_winsize(master, size)

    child_alive = [True]
    stop = [False]

    def on_winch(_signum, _frame):
        new_size = winsize(stdout_fd) if stdout_fd is not None else None
        if new_size is None and stdin_fd is not None:
            new_size = winsize(stdin_fd)
        apply_winsize(master, new_size)
        if child_alive[0]:
            try:
                os.kill(pid, signal.SIGWINCH)
            except OSError:
                pass

    def on_term(signum, _frame):
        stop[0] = True
        if child_alive[0]:
            try:
                os.kill(pid, signum)
            except OSError:
                pass

    # The handlers are installed before the terminal is put in raw mode, so
    # a signal that arrives in between is not lost.
    try:
        signal.signal(signal.SIGWINCH, on_winch)
        signal.signal(signal.SIGTERM, on_term)
        signal.signal(signal.SIGHUP, on_term)
    except (OSError, ValueError):
        pass

    saved_term = None
    tap = None
    output = None
    status = None
    failure = None
    try:
        # Raw mode is inside the try: an exception between here and the loop
        # must still restore the terminal.
        if is_tty:
            try:
                saved_term = termios.tcgetattr(stdin_fd)
                tty.setraw(stdin_fd)
            except termios.error:
                saved_term = None
        tap = Tap(pid, store, agent=agent, session=session, master_fd=master,
                  window=window)
        output = Output(stdout_fd)
        watch_stdin = stdin_fd is not None
        while not stop[0]:
            # A child that exits while a grandchild keeps the pty open must
            # not keep the tap alive: the exit is noticed here, and the rest
            # of the pty is drained before the tap stops.
            try:
                waited, wstatus = os.waitpid(pid, os.WNOHANG)
            except ChildProcessError:
                waited, wstatus = pid, 0
            if waited == pid:
                status = wstatus
                child_alive[0] = False
                drain(master, output, tap)
                break

            watched = [master] + ([stdin_fd] if watch_stdin else [])
            try:
                readable, _w, _x = select.select(watched, [], [], RELAY_TIMEOUT)
            except InterruptedError:
                continue
            except OSError:
                break
            if master in readable:
                data = read_some(master)
                if data is None:
                    # The pty is gone: the child is done with it.
                    break
                if data:
                    # Every byte goes to the terminal unchanged; the report
                    # is only watched, never rewritten and never sent back.
                    output.write(data)
                    tap.feed(data)
            if watch_stdin and stdin_fd in readable:
                data = read_input(stdin_fd)
                if data is None:
                    # End of input: stop watching stdin, or a closed pipe would
                    # keep select reporting it readable and spin the loop.
                    watch_stdin = False
                elif data:
                    # The user input is not dropped: the pty takes what it
                    # can, and the rest waits for room.
                    # A child that never reads its stdin must not block the
                    # relay; when the queue is full, drop the tail rather than
                    # freeze every direction for seconds.
                    write_all(master, data, timeout=INPUT_TIMEOUT)
    except BaseException as error:  # the tap must not die dirty
        failure = error
    finally:
        if saved_term is not None:
            try:
                termios.tcsetattr(stdin_fd, termios.TCSAFLUSH, saved_term)
            except termios.error:
                pass
        # The child is gone: the records that are still running go with it.
        try:
            if tap is not None:
                tap.close()
        except Exception:  # noqa: BLE001 - cleanup must not raise
            pass
        try:
            os.close(master)
        except OSError:
            pass
        if output is not None:
            output.close()
        store.close()

    if status is None:
        child_alive[0] = False
        status = reap(pid)
    if failure is not None:
        if isinstance(failure, KeyboardInterrupt):
            print("muster-tap: interrupted", file=sys.stderr)
            return 130
        print(f"muster-tap: {failure}", file=sys.stderr)
        return 1
    code = os.waitstatus_to_exitcode(status)
    return code if code >= 0 else 128 - code


def drain(master, output, tap, total=1.0, quiet=0.2, limit=1 << 20):
    """Forward what is left in the pty once the child is gone.

    A grandchild can keep the pty open and keep writing. The drain is bounded
    by a wall-clock deadline, a byte budget and a quiet period, so it cannot
    pin the tap (and the terminal in raw mode) forever.
    """
    deadline = now() + total
    last = now()
    seen = 0
    while now() < deadline and seen < limit:
        data = read_some(master)
        if data is None:
            return
        if not data:
            if now() - last >= quiet:
                return
            time.sleep(0.01)
            continue
        last = now()
        seen += len(data)
        output.write(data)
        tap.feed(data)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
