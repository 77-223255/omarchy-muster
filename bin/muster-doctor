#!/bin/bash
#
# Dependency and state check for the shienze.muster plugin.
#
# This branch is protocol-only. bin/muster-tap is the only writer: it runs an
# agent on a pty, speaks OSC 7501 with it, and writes the JSON record itself
# with the Python 3 standard library. There is no report writer, no agent
# bridge and no hook, so the checks below are the ones this branch needs:
#
#   * python3 and bin/muster-tap — the writer, and the only way a session
#     exists at all;
#   * the handful of tools the omarchy shell service shells out to;
#   * hyprctl (plus tmux/herdr inside a multiplexer) to focus a session;
#   * paplay and omarchy-notification-send for the completion alert;
#   * the state directory: a real, owner-only directory, and owner-only
#     records in it.
#
# Nothing here needs jq, flock, base64, sed, iconv or sha1sum: the writer is
# Python and the shell side never parses JSON.
#
#   muster-doctor [--json]

set -uo pipefail

json=0
[[ ${1:-} == "--json" ]] && json=1

plugin_dir=${MUSTER_PLUGIN_DIR:-$HOME/.config/omarchy/plugins/shienze.muster}
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" 2>/dev/null && pwd) || script_dir="."
state_base=${XDG_STATE_HOME:-$HOME/.local/state}
# The writer refuses a relative XDG_STATE_HOME. A doctor that audited one would
# report on a directory the plugin never uses, a false all-green.
[[ $state_base == /* ]] || { echo "muster-doctor: XDG_STATE_HOME must be an absolute path (got: $state_base)" >&2; exit 2; }
state_dir="$state_base/omarchy/muster/sessions"
marks_dir="$state_base/omarchy/muster/marks"

ok=0
missing=0
optional=0
rows=()

# Anything printed may derive from a record another integration wrote, so it
# is stripped of control bytes first: a terminal executes ANSI/OSC sequences,
# and a record's name or project can carry them.
#
# The C1 range and the bidi/format code points are removed as whole
# characters, never as a byte range: a byte range over 0x80-0x9f would eat the
# continuation bytes of ordinary multi-byte text and corrupt it.
clean() {
  local s=$1 ch i
  s=${s//[$'\x01'-$'\x1f'$'\x7f']/}
  for ((i = 0x80; i <= 0x9f; i++)); do
    printf -v ch '%b' "\\u$(printf '%04x' "$i")"
    s=${s//$ch/}
  done
  for i in 200b 200c 200d 200e 200f 202a 202b 202c 202d 202e 2066 2067 2068 2069 feff; do
    printf -v ch '%b' "\\u$i"
    s=${s//$ch/}
  done
  printf '%s' "$s"
}

record() {
  # record <status> <name> <detail>
  # Unit Separator, not a pipe: the detail is untrusted text and may contain a
  # pipe, which the JSON split below would otherwise truncate.
  rows+=("$1"$'\x1f'"$2"$'\x1f'"$(clean "$3")")
  case $1 in
  ok) ok=$((ok + 1)) ;;
  missing) missing=$((missing + 1)) ;;
  *) optional=$((optional + 1)) ;;
  esac
}

have() {
  # have <command> <why> [required]
  local cmd=$1 why=$2 required=${3:-required}
  if command -v "$cmd" >/dev/null 2>&1; then
    record ok "$cmd" "$(command -v "$cmd") · $why"
  elif [[ $required == required ]]; then
    record missing "$cmd" "$why"
  else
    record optional "$cmd" "$why (optional)"
  fi
}

# ------------------------------------------------------------- runtime

if command -v quickshell >/dev/null 2>&1; then
  record ok quickshell "$(quickshell --version 2>/dev/null || echo present) · hosts the plugin"
else
  record missing quickshell "the omarchy shell host; without it no plugin runs"
fi

if omarchy-shell shell ping >/dev/null 2>&1; then
  record ok "shell running" "IPC reachable"
  # The plugin list is read as text: this doctor must not need jq.
  plugin_line=$(omarchy plugin list 2>/dev/null | grep -E "^shienze\.muster[[:space:]]" | head -n 1)
  if [[ -z $plugin_line ]]; then
    record missing "plugin enabled" "shienze.muster is not in the plugin list; omarchy-shell shell rescanPlugins"
  else
    read -r _plugin_id plugin_state _rest <<<"$plugin_line"
    if [[ $plugin_state == "enabled" ]]; then
      record ok "plugin enabled" "shienze.muster is in the bar layout"
    else
      record missing "plugin enabled" "shienze.muster is $plugin_state; run: omarchy plugin enable shienze.muster left"
    fi
  fi
  if omarchy-shell shienze.muster status >/dev/null 2>&1; then
    record ok "plugin IPC" "$(omarchy-shell shienze.muster status 2>/dev/null)"
  else
    record missing "plugin IPC" "target shienze.muster not answering; omarchy restart shell"
  fi
else
  record missing "shell running" "omarchy-shell did not answer; omarchy restart shell"
fi

# ------------------------------------------------------------ detection

if [[ -f $plugin_dir/Service.qml && -f $plugin_dir/BarWidget.qml && -f $plugin_dir/Panel.qml \
      && -f $plugin_dir/Record.qml && -f $plugin_dir/Model.js ]]; then
  record ok "plugin source" "$plugin_dir"
else
  record missing "plugin source" "$plugin_dir is missing Service/BarWidget/Panel/Record/Model files"
fi

# --------------------------------------------------------------- writer

# The tap is the only writer in this branch: without it no agent reports and
# the bar stays empty. A checkout that is not installed still has the script
# next to this one, so that case is checked too.
tap="$plugin_dir/bin/muster-tap"
if [[ ! -x $tap && -x $script_dir/muster-tap ]]; then
  tap="$script_dir/muster-tap"
fi
if [[ -x $tap ]]; then
  record ok "muster-tap" "$tap"
elif [[ -f $tap ]]; then
  record missing "muster-tap" "$tap is not executable; run: chmod +x $tap"
else
  record missing "muster-tap" "not found; the only writer of this branch is missing"
fi

# A pi extension that an older branch linked is left over: nothing reads it
# any more, and it would only confuse the user. It is not an error.
pi_extension=$HOME/.pi/agent/extensions/muster.ts
if [[ -e $pi_extension || -L $pi_extension ]]; then
  record optional "pi extension link" "$pi_extension is left over from an older branch; remove: rm -f $pi_extension"
fi

if command -v python3 >/dev/null 2>&1; then
  record ok python3 "$(command -v python3) · runs bin/muster-tap"
  # The tap needs these standard-library modules; a python without them (or
  # too old for the syntax) cannot write a record.
  if python3 -c 'import json, os, pty, termios, select, fcntl, struct, base64, hashlib, secrets, stat' >/dev/null 2>&1; then
    record ok "python stdlib" "pty, termios and the rest of the tap's imports are there"
  else
    record missing "python stdlib" "this python3 cannot import the modules bin/muster-tap needs"
  fi
else
  record missing python3 "bin/muster-tap is a python3 script; install python3"
fi

# ---------------------------------------------------------- shell side

# The omarchy service is a shell script inside QML: it creates the state
# directory, lists the records, reads one with dd and prunes the old ones.
for tool in bash find sort head stat dd mkdir chmod timeout od tr; do
  have "$tool" "the shell service reads, lists and prunes the records"
done

# inotifywait only makes a new record show up at once instead of on the next
# scan, so it is a nicety, not a requirement.
have inotifywait "showing a new session at once instead of on the next scan" optional

# --------------------------------------------------------------- focus

have hyprctl "focusing a session's terminal on click"

# herdr runs agent panes under a daemon, so a click needs its CLI to switch
# back to the pane; only sessions inside herdr use it.
if [[ ${HERDR_ENV:-} == "1" ]] || [[ -S ${HERDR_SOCKET_PATH:-$HOME/.config/herdr/herdr.sock} ]]; then
  have herdr "switching to a session's herdr pane on click" required
else
  have herdr "switching to a session's herdr pane on click" optional
fi

# tmux keeps its panes under a server, so a click needs its CLI to switch the
# attached client back to the pane; only sessions inside tmux use it. There is no
# reliable way to detect that from outside a pane, so it is required only when
# this very run is inside tmux.
if [[ -n ${TMUX:-} ]]; then
  have tmux "switching to a session's tmux pane on click" required
else
  have tmux "switching to a session's tmux pane on click" optional
fi

# --------------------------------------------------------------- alerts

# paplay is what the shipped widget calls (soundPlayer in Service.qml); the
# others only help if the user edits that line, so they are not a pass.
if command -v paplay >/dev/null 2>&1; then
  record ok "audio player" "$(command -v paplay)"
else
  record missing "audio player" "the completion sound calls paplay; install pipewire-pulse"
fi

sound_file=/usr/share/sounds/freedesktop/stereo/complete.oga
if [[ -r $sound_file ]]; then
  record ok "sound file" "$sound_file"
else
  record optional "sound file" "$sound_file not readable; change soundFile in the widget settings"
fi

have omarchy-notification-send "the desktop popup on completion"

# ---------------------------------------------------------------- state

# mkdir and every later open follow a symlinked component, so a link at any
# level moves the whole directory out of the state home. The writer refuses
# such a path, which means no record is written at all. Check every component
# even when the sessions directory itself does not exist yet: a symlinked
# omarchy/muster whose target has no sessions/ is still a broken writer.
linked=""
broken=""
for c in omarchy omarchy/muster omarchy/muster/sessions; do
  p="$state_base/$c"
  if [[ -L $p ]]; then
    linked="$p is a symlink"
    break
  fi
  if [[ -e $p && ! -d $p ]]; then
    broken="$p is not a directory"
    break
  fi
  if [[ -e $p && ! -O $p ]]; then
    broken="$p is not owned by this user"
    break
  fi
done
if [[ -n $linked ]]; then
  record missing "state path" "$linked; the writer refuses it"
elif [[ -n $broken ]]; then
  record missing "state path" "$broken; the writer refuses it"
else
  record ok "state path" "no symlinked component under $state_base/omarchy"
fi

if [[ -L $state_dir ]]; then
  record missing "sessions dir type" "$state_dir is a symlink; the writer refuses it"
elif [[ -d $state_dir ]]; then
  record_count=$(find -- "$state_dir" -maxdepth 1 -type f -name '*.json' 2>/dev/null | wc -l)
  record ok "sessions dir" "$state_dir ($record_count record(s))"

  # The writer refuses a directory that is not exactly 0700, so a
  # group/other-readable one is a leak and a broken writer, not a style nit.
  dir_mode=$(stat -c '%a' -- "$state_dir" 2>/dev/null || echo unknown)
  if [[ $dir_mode != "700" ]]; then
    record missing "sessions dir mode" "$dir_mode — the writer refuses it; run: chmod 700 $state_dir"
  else
    record ok "sessions dir mode" "700 (owner-only)"
  fi

  if [[ -O $state_dir ]]; then
    record ok "sessions dir owner" "owned by this user"
  else
    record missing "sessions dir owner" "not owned by this user; the writer refuses it"
  fi

  # A record is published with mode 0600 and the writer refuses anything else,
  # so a readable record is both a leak and a record the writer cannot replace.
  open_records=$(find -- "$state_dir" -maxdepth 1 -type f -name '*.json' ! -perm 600 -print 2>/dev/null | wc -l)
  if ((open_records > 0)); then
    record missing "record mode" "$open_records record(s) are not 0600; run: chmod 600 $state_dir/*.json"
  else
    record ok "record mode" "records are 0600 (owner-only)"
  fi

  # The reader refuses a symlink, a special file and an oversized record, so a
  # bad one is a silent missing session; surface it instead.
  bad_type=$(find -- "$state_dir" -maxdepth 1 -name '*.json' ! -type f 2>/dev/null | wc -l)
  if ((bad_type > 0)); then
    record missing "record type" "$bad_type record(s) are not plain files; the reader refuses them"
  else
    record ok "record type" "records are plain files"
  fi
  linked_records=$(find -- "$state_dir" -maxdepth 1 -name '*.json' -type l 2>/dev/null | wc -l)
  if ((linked_records > 0)); then
    record missing "record symlink" "$linked_records record(s) are symlinks; the reader refuses them"
  else
    record ok "record symlink" "no record is a symlink"
  fi
  oversized=$(find -- "$state_dir" -maxdepth 1 -name '*.json' -type f -size +64k 2>/dev/null | wc -l)
  if ((oversized > 0)); then
    record missing "record size" "$oversized record(s) over 64 KiB; the reader refuses them"
  else
    record ok "record size" "records are within 64 KiB"
  fi
else
  record optional "sessions dir" "$state_dir (created by the first tap)"
fi

# The marks are generated SVGs with no session data, so they stay readable —
# but the directory they are written into must still be a real directory owned
# by this user, or the shell would follow a link a same-user writer left there.
if [[ -L $marks_dir ]]; then
  record missing "marks dir" "$marks_dir is a symlink; the shell refuses to write marks"
elif [[ -d $marks_dir ]]; then
  if [[ -O $marks_dir ]]; then
    record ok "marks dir" "$marks_dir ($(find -- "$marks_dir" -maxdepth 1 -name '*.svg' 2>/dev/null | wc -l) mark(s))"
  else
    record missing "marks dir" "$marks_dir is not owned by this user"
  fi
else
  record optional "marks dir" "$marks_dir (created on first write)"
fi

# ---------------------------------------------------------------- output

json_escape() {
  # The detail is untrusted text and may hold a quote or a backslash.
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  printf '%s' "$s"
}

if ((json)); then
  printf '{\n  "ok": %d,\n  "optional": %d,\n  "missing": %d,\n  "checks": [\n' \
    "$ok" "$optional" "$missing"
  total=${#rows[@]}
  index=0
  for row in "${rows[@]}"; do
    IFS=$'\x1f' read -r status name detail <<<"$row"
    index=$((index + 1))
    comma=","
    ((index == total)) && comma=""
    printf '    {"status": "%s", "name": "%s", "detail": "%s"}%s\n' \
      "$(json_escape "$status")" "$(json_escape "$name")" "$(json_escape "$detail")" "$comma"
  done
  printf '  ]\n}\n'
else
  for row in "${rows[@]}"; do
    IFS=$'\x1f' read -r status name detail <<<"$row"
    case $status in
    ok) printf '  \033[32m✓\033[0m %-22s %s\n' "$name" "$detail" ;;
    missing) printf '  \033[31m✗\033[0m %-22s %s\n' "$name" "$detail" ;;
    *) printf '  \033[33m·\033[0m %-22s %s\n' "$name" "$detail" ;;
    esac
  done
  printf '\n  %d ok, %d missing, %d optional\n' "$ok" "$missing" "$optional"
fi

((missing == 0))
