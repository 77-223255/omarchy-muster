#!/bin/bash

# Writer for the shienze.muster shell plugin, for every agent that is not
# pi. Any integration can call this to publish a session record; the plugin
# watches the sessions directory and never talks to the agent itself.
#
# It is the hook-side front end of the Program Status Protocol (OSC 7501):
#   https://www.superlogical.com/rex/docs/build/program-status
# A caller can set the standard fields with options, or hand over the exact
# key=value body a program would write to its terminal — state, kind, progress,
# id, app, title, msg — on a descriptor with --osc-fd. With --emit-osc the same
# report is written back to a terminal as a real OSC 7501 sequence, so any
# consumer (Rex today, Ghostty and others later) sees it too.
#
# A body that arrives on --osc-fd is a report in the spec's sense, and the
# spec's rules for it are followed exactly: it is parsed, then validated as a
# whole, and only then applied. A report is published in full or not at all.
# A report without a state is ignored — the spec never says "assume
# working", and a default would invent a run that never started. A report
# whose title or msg does not decode, decodes to a control character or is
# over the spec's limit is discarded whole: a card that shows a state
# without its text says something the program never said. An unknown kind
# and a progress that is not an integer in 0..100 are absent, not fatal;
# the spec says so, and they do not invalidate the rest of the report.
#
# Nothing a caller types may travel as an argument. A process's argv is
# world-readable through /proc/<pid>/cmdline while it runs, so the only options
# that take text here take a descriptor: --prompt-fd, --message-fd, --name-fd,
# --cwd-fd, --osc-fd. The remaining options are ids, state words and numbers and
# are validated against fixed shapes, so they cannot carry text either.
#
#   # a protocol-native writer: emit the sequence and publish the record at once
#   printf '%s' "$OSC_BODY" | muster-report --agent claude --session "$ID" \
#     --osc-fd 0 --emit-osc tty
#
#   # a run started — the prompt arrives on stdin, never as an argument
#   { printf '%s' "$TITLE"; printf '%s' "$PROMPT"; } | muster-report \
#     --agent claude --session "$ID" --state working \
#     --name-fd 3 --prompt-fd 0 3< <(printf '%s' "$TITLE")
#
#   # a run finished (this is what triggers the sound + notification)
#   muster-report --agent claude --session "$ID" --state done --emit-osc tty
#
#   # waiting on the user
#   printf '%s' "approve the patch" | muster-report --agent claude --session "$ID" \
#     --state blocked --kind permission --message-fd 0
#
#   # failed
#   muster-report --agent claude --session "$ID" --state error
#
#   # gone
#   muster-report --agent claude --session "$ID" --remove
#
#   # a record that belongs to a pty (the tap writes "tap:<pid>")
#   muster-report --agent claude --session "$ID" --terminal-id tap:4711 \
#     --state working
#
# `--agent` takes any id omarchy ships (pi, omp, opencode, claude, codex, crush,
# grok, gemini, openclaw, hermes, copilot, muse, cursor-agent) plus their
# aliases; an unknown id still works and gets the generic mark. It may instead
# come from `app=` in the OSC body.

set -euo pipefail
# The wire and the file name are byte-oriented: the value charset, the space
# trimming, the caps and the digests must not change with the user's locale.
export LC_ALL=C

# A record carries the last user prompt and the working directory, so nothing
# this script creates may be readable by another local user. umask 077 makes
# the staging file owner-only; the chmods below also repair a directory or
# record left behind world-readable by an older version.
umask 077

usage() {
  cat <<'USAGE'
Usage: muster-report --agent <id> --session <id> [options]

  --state <idle|working|done|blocked|error|clear|unknown>
                       Session state (default: working for a plain command
                       line call). `done` and `error` are the settled
                       states: they trigger the alert, survive process exit,
                       and are what a finished run reports. `clear` removes
                       the record, like --remove. A body read from --osc-fd
                       must carry its own state: a report without one is
                       ignored, never defaulted.
  --kind <permission|question|auth>
                       Why a `blocked` session is waiting (OSC 7501 kind).
  --progress <0-100>   Progress for a working/blocked session.
  --record-id <id>     OSC 7501 record id, e.g. build/test.
  --terminal-id <id>   The pty/tap that owns the record, e.g. tap:4711
                       (default: $MUSTER_TERMINAL_ID; empty = absent).
  --osc-fd <n>         Read an OSC 7501 key=value body from descriptor n and
                       take state/kind/progress/id/app/title/msg from it. The
                       body is validated as a whole: a report that breaks the
                       spec's grammar or its limits is discarded, and nothing
                       is written.
  --emit-osc <fd|tty>  Write the report to a terminal as an OSC 7501 sequence.
                       A removal is emitted as `state=clear`, and kind and
                       progress are only emitted for a working or blocked
                       report.
  --name-fd <n>        Read the display name from descriptor n (never argv)
  --cwd-fd <n>         Read the working directory from descriptor n (never argv)
  --prompt-fd <n>      Read the last prompt from descriptor n (never argv)
  --message-fd <n>     Read the blocked detail from descriptor n (never argv)
  --pid <n>            Owning process id (default: $PPID)
  --window <value>     Hyprland window address, "auto" (default) or "none"
  --herdr-pane <id>    herdr pane to focus (default: $HERDR_PANE_ID when in herdr)
  --tmux-pane <id>     tmux pane to focus (default: $TMUX_PANE when in tmux)
  --tmux-socket <path> tmux server socket (default: from $TMUX; empty = default server)
  --completed          Increment completedRuns: a run just settled
  --remove             Delete the record and exit
  --json               Print the resulting record (which includes the
                        prompt and the working directory) to stdout
  -h, --help           This text

Environment:
  XDG_STATE_HOME       Defaults to ~/.local/state
  MUSTER_TERMINAL_ID   Used as --terminal-id when the option is not given
  HERDR_PANE_ID        Picked up as --herdr-pane when HERDR_ENV=1
  TMUX, TMUX_PANE      Picked up as --tmux-socket and --tmux-pane when in tmux
USAGE
}

fail() {
  echo "muster-report: $*" >&2
  exit 1
}

agent=""
session=""
state=""
kind=""
progress=""
record_id=""
terminal_id=""
terminal_id_from_env=0
name=""
cwd="$PWD"
prompt=""
message=""
prompt_fd=""
message_fd=""
name_fd=""
cwd_fd=""
osc_fd=""
emit_osc=""
pid="$PPID"
window="auto"
herdr_pane=""
[[ ${HERDR_ENV:-} == "1" ]] && herdr_pane="${HERDR_PANE_ID:-}"
# tmux injects TMUX_PANE ("%3") and TMUX ("<socket>,<pid>,<session>") into every
# pane. Both are only read when the pane id is the shape tmux writes, so a
# stray environment cannot put an arbitrary value into the record.
tmux_pane=""
tmux_socket=""
if [[ ${TMUX_PANE:-} =~ ^%[0-9]{1,6}$ ]]; then
  tmux_pane="$TMUX_PANE"
  tmux_socket="${TMUX%%,*}"
fi
completed=0
remove=0
print_json=0

while (($# > 0)); do
  case "$1" in
  --agent) agent="${2:-}"; shift 2 || fail "--agent needs a value" ;;
  --session) session="${2:-}"; shift 2 || fail "--session needs a value" ;;
  --state) state="${2:-}"; shift 2 || fail "--state needs a value" ;;
  --kind) kind="${2:-}"; shift 2 || fail "--kind needs a value" ;;
  --progress) progress="${2:-}"; shift 2 || fail "--progress needs a value" ;;
  --record-id) record_id="${2:-}"; shift 2 || fail "--record-id needs a value" ;;
  --terminal-id) terminal_id="${2:-}"; shift 2 || fail "--terminal-id needs a value" ;;
  --name-fd) name_fd="${2:-}"; shift 2 || fail "--name-fd needs a value" ;;
  --cwd-fd) cwd_fd="${2:-}"; shift 2 || fail "--cwd-fd needs a value" ;;
  --prompt-fd) prompt_fd="${2:-}"; shift 2 || fail "--prompt-fd needs a value" ;;
  --message-fd) message_fd="${2:-}"; shift 2 || fail "--message-fd needs a value" ;;
  --osc-fd) osc_fd="${2:-}"; shift 2 || fail "--osc-fd needs a value" ;;
  --emit-osc) emit_osc="${2:-}"; shift 2 || fail "--emit-osc needs a value" ;;
  # The text forms are deliberately gone, not deprecated: text only enters
  # through a descriptor.
  --name | --cwd | --prompt | --message)
    fail "$1 puts user text on the process command line; pipe it to --name-fd/--cwd-fd/--prompt-fd/--message-fd instead" ;;
  --pid) pid="${2:-}"; shift 2 || fail "--pid needs a value" ;;
  --window) window="${2:-}"; shift 2 || fail "--window needs a value" ;;
  --herdr-pane) herdr_pane="${2:-}"; shift 2 || fail "--herdr-pane needs a value" ;;
  --tmux-pane) tmux_pane="${2:-}"; shift 2 || fail "--tmux-pane needs a value" ;;
  --tmux-socket) tmux_socket="${2:-}"; shift 2 || fail "--tmux-socket needs a value" ;;
  --completed) completed=1; shift ;;
  --remove) remove=1; shift ;;
  --json) print_json=1; shift ;;
  -h | --help) usage; exit 0 ;;
  *) fail "unknown option: $1" ;;
  esac
done

# User text and paths never travel as arguments when a caller can pass a file
# descriptor instead: a process's argv is world-readable through
# /proc/<pid>/cmdline while it runs, and no file mode can protect a value
# handed over that way. `read` is a shell builtin, and each read is capped so
# neither the shell nor the record can grow without bound. The cap is a byte
# count, so the read runs in the C locale: a multibyte character must not buy
# a caller extra bytes past the limit.
read_fd() {
  local fd="$1" cap="$2" value=""
  local LC_ALL=C
  IFS= read -r -N "$cap" value <&"$fd" 2>/dev/null || true
  printf '%s' "$value"
}

# The terminal id names the pty (or the tap) a record belongs to. It keys a
# session in the reader, so it is an id and not text: it is held to a plain
# charset and never carries anything else. An explicit value that does not
# fit is a mistake and is reported; the environment is only a hint, so an
# unusable one is dropped with a warning instead of failing every write.
if [[ -z $terminal_id && -n ${MUSTER_TERMINAL_ID:-} ]]; then
  terminal_id="$MUSTER_TERMINAL_ID"
  terminal_id_from_env=1
fi
if [[ -n $terminal_id && ! $terminal_id =~ ^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$ ]]; then
  if ((terminal_id_from_env)); then
    echo "muster-report: MUSTER_TERMINAL_ID is not a terminal id; ignoring it" >&2
    terminal_id=""
  else
    fail "--terminal-id must be an id: letters, digits, dot, dash, underscore, colon (max 64)"
  fi
fi

# Free text and paths never reach a file name directly: a session id becomes
# `<agent>~<session>.json`, so it is reduced to a plain, path-safe token first.
sanitize() { local v="${1//[^a-zA-Z0-9._-]/_}"; printf '%s' "${v:0:80}"; }

# The session of a report that carries an id names the record file, so it has
# to be a short plain token: a protocol id can be 263 bytes long and a file
# name cannot be that. The raw id stays in the record as recordId, so nothing
# is lost but the name. The digest is ALWAYS appended: sanitising maps `/` to
# `_` and truncation cuts, so without it two different ids could name the same
# file and one program could overwrite another program's record. The empty id
# is the root record; it is scoped by the terminal id (or the writer pid) so
# id-less reports from two processes do not collide either.
hash_id() { printf '%s' "$1" | sha1sum | cut -c1-16; }

osc_session() {
  local raw="$1" token digest
  if [[ -z $raw ]]; then
    # The root record is one per terminal. Without a terminal id the caller
    # must supply --session (checked above); a bare "root" is used only for
    # that explicit single-session case, not to guess a scope from the pid.
    if [[ -n $terminal_id ]]; then
      printf 'root-%s' "$(hash_id "root:$terminal_id")"
    else
      printf 'root'
    fi
    return 0
  fi
  token=$(sanitize "$raw" | cut -b1-40)
  # An id of the shape the session uses starts with a letter or a digit.
  [[ $token =~ ^[A-Za-z0-9] ]] || token="id${token:0:38}"
  # The digest is scoped by the terminal id when there is one: two taps that
  # report the same id are two records. Without one, the raw id is the only
  # stable identity a hook has, so hash that alone. A digest is uniqueness,
  # not a secret: any same-user writer can still forge a record.
  if [[ -n $terminal_id ]]; then
    digest=$(hash_id "term:$terminal_id:$raw")
  else
    digest=$(hash_id "$raw")
  fi
  printf '%s-%s' "$token" "$digest"
}

[[ -z $prompt_fd || $prompt_fd =~ ^[0-9]+$ ]] ||
  fail "--prompt-fd must be a descriptor number"
[[ -z $message_fd || $message_fd =~ ^[0-9]+$ ]] ||
  fail "--message-fd must be a descriptor number"
[[ -z $name_fd || $name_fd =~ ^[0-9]+$ ]] ||
  fail "--name-fd must be a descriptor number"
[[ -z $cwd_fd || $cwd_fd =~ ^[0-9]+$ ]] ||
  fail "--cwd-fd must be a descriptor number"
[[ -z $osc_fd || $osc_fd =~ ^[0-9]+$ ]] ||
  fail "--osc-fd must be a descriptor number"
[[ -z $emit_osc || $emit_osc =~ ^(tty|[0-9]+)$ ]] ||
  fail "--emit-osc must be a descriptor number or \"tty\""

# ------------------------------------------------------------- OSC 7501 in
#
# The wire format of the Program Status Protocol (spec rev 0.4): a report is
# a ':'-separated list of key=value pairs. The three steps are kept apart —
# parse the body, validate the whole report, then apply it — because a
# report is published in full or not at all. A state without its text is a
# card that says nothing, and the spec never says to publish half a report.
#
# These are the spec's limits. A report that breaks one of them is discarded
# whole, never trimmed into something that says something else.
OSC_MAX_BODY=4096
OSC_MAX_KEY=16
OSC_MAX_APP=32
OSC_MAX_ID=263
OSC_MAX_TITLE_ENC=256
OSC_MAX_TITLE_DEC=192
OSC_MAX_MSG_ENC=2732
OSC_MAX_MSG_DEC=2048


# Decode a protocol free-text value: standard base64 of UTF-8, padding
# optional. The spec's rule is all-or-nothing, so a value that does not
# decode, that decodes to a control character or that is over its limit
# fails the whole report: the caller discards the report instead of
# publishing a state without its text. The spec forbids control characters,
# and a newline in a project name would forge card text.
osc_decode() {
  local encoded="$1" max_enc="$2" max_dec="$3" decoded raw
  # The C locale: the limits are byte counts, and the control characters the
  # spec forbids are C0, DEL and the C1 range. In a UTF-8 locale the byte of
  # a multi-byte character can look like a control byte, and the C1 range is
  # invisible to the locale's class, so both are checked as bytes here.
  local LC_ALL=C
  [[ -n $encoded ]] || return 0
  ((${#encoded} <= max_enc)) || return 1
  [[ $encoded =~ ^[A-Za-z0-9+/=]*$ ]] || return 1
  # The trailing '.' is a sentinel: a command substitution eats a trailing
  # newline, and a decoded newline is a control character that must not slip
  # through the check below.
  decoded=$(printf '%s' "$encoded" | base64 -d 2>/dev/null && printf '.') || return 1
  decoded=${decoded%.}
  raw=$(printf '%s' "$encoded" | base64 -d 2>/dev/null | wc -c) || return 1
  ((raw <= max_dec)) || return 1
  # A NUL byte cannot live in a shell variable — it is dropped on the way in
  # — so a string shorter than the raw decode means that one was there.
  ((raw == $(printf '%s' "$decoded" | wc -c))) || return 1
  # A lone C1 byte is not valid UTF-8; iconv rejects it, and the two-byte
  # U+0080-U+009F forms are caught below.
  printf '%s' "$decoded" | iconv -f UTF-8 -t UTF-8 >/dev/null 2>&1 || return 1
  [[ $decoded != *[[:cntrl:]]* ]] || return 1
  # The C1 controls (U+0080-U+009F) are two-byte sequences in UTF-8, so the
  # class above never sees them: they are matched as bytes.
  [[ $decoded != *$'\xc2'[$'\x80'-$'\x9f']* ]] || return 1
  printf '%s' "$decoded"
}

osc_state="" osc_kind="" osc_progress="" osc_app="" osc_id="" osc_id_seen=0 osc_id_bad=0
osc_title="" osc_msg="" osc_title_text="" osc_msg_text=""

if [[ -n $osc_fd ]]; then
  # ---------------------------------------------------------- 1. parse
  # The body is read with room for the sequence wrapper, so a body that is
  # too long is noticed instead of being truncated into a valid-looking
  # report.
  raw_osc=$(read_fd "$osc_fd" $((OSC_MAX_BODY + 16)))
  osc_raw_bytes=$(printf '%s' "$raw_osc" | wc -c)
  ((osc_raw_bytes < OSC_MAX_BODY + 16)) ||
    fail "the --osc-fd body is over the $OSC_MAX_BODY bytes the spec allows; the report is discarded"
  # Accept either the bare body ("state=…:…") or a whole sequence, so a hook
  # can pipe the very bytes it wrote to its tty straight through. Trailing BEL
  # or ESC \ is stripped; anything the caller leaves is an unknown pair and is
  # ignored below.
  raw_osc=${raw_osc#$'\033]7501;'}
  raw_osc=${raw_osc%$'\033\\'}
  raw_osc=${raw_osc%$'\a'}
  osc_body_bytes=$(printf '%s' "$raw_osc" | wc -c)
  ((osc_body_bytes <= OSC_MAX_BODY)) ||
    fail "the --osc-fd body is over the $OSC_MAX_BODY bytes the spec allows; the report is discarded"
  # Pairs are ':'-separated, and the value charset excludes ':' and ';', so a
  # plain split is exact. A malformed pair is skipped; the rest still applies.
  # Unknown keys are ignored — that is how the protocol extends.
  osc_rest="$raw_osc"
  while [[ -n $osc_rest ]]; do
    if [[ $osc_rest == *:* ]]; then
      osc_pair=${osc_rest%%:*}
      osc_rest=${osc_rest#*:}
    else
      osc_pair=$osc_rest
      osc_rest=""
    fi
    [[ $osc_pair == *=* ]] || continue
    key=${osc_pair%%=*}
    val=${osc_pair#*=}
    # The spec removes whitespace around keys and values. Parameter expansion,
    # not a command substitution: a 4 KiB body can hold ~800 pairs and two
    # forks per pair was a self-inflicted fork bomb.
    key="${key#"${key%%[![:space:]]*}"}"
    key="${key%"${key##*[![:space:]]}"}"
    val="${val#"${val%%[![:space:]]*}"}"
    val="${val%"${val##*[![:space:]]}"}"
    # A key is 1..16 lowercase letters; anything else is not a key.
    ((${#key} <= OSC_MAX_KEY)) || continue
    [[ $key =~ ^[a-z]+$ ]] || continue
    # The value charset is what the wire allows. A value outside it makes the
    # pair malformed; a malformed *id* is worse than a malformed other pair:
    # dropping it would turn the report into an id-less (root) report.
    if [[ ! $val =~ ^[A-Za-z0-9_.,+/=-]*$ ]]; then
      [[ $key == id ]] && osc_id_bad=1
      continue
    fi
    # A repeated key keeps the last value.
    case "$key" in
    state) osc_state=$val ;;
    kind) osc_kind=$val ;;
    progress) osc_progress=$val ;;
    app) osc_app=$val ;;
    id) osc_id=$val; osc_id_seen=1 ;;
    title) osc_title=$val ;;
    msg) osc_msg=$val ;;
    esac
  done

  # --------------------------------------------------- 2. validate the whole
  # A report without a state is ignored: the spec never says "assume
  # working", and a default would invent a run that never started.
  [[ -n $osc_state ]] ||
    fail "the --osc-fd body has no state; a report without a state is ignored"
  # A state the spec does not define is ignored as well.
  case "$osc_state" in
  idle | working | done | blocked | error | clear) ;;
  *) fail "the --osc-fd body has the unknown state '$osc_state'; the report is ignored" ;;
  esac
  # An id that breaks the grammar breaks the whole report: the record would
  # be filed under the wrong address, and a wrong record is worse than none.
  # An absent id is the root record; an explicit empty id is not the same
  # thing and must not fall back to the root (which could overwrite it).
  if ((osc_id_bad)); then
    fail "the --osc-fd body has an invalid id; the report is ignored"
  fi
  if ((osc_id_seen)); then
    if ((${#osc_id} > OSC_MAX_ID)) || [[ -z $osc_id ]] ||
      [[ ! $osc_id =~ ^[A-Za-z0-9_.+-]{1,32}(/[A-Za-z0-9_.+-]{1,32}){0,7}$ ]]; then
      fail "the --osc-fd body has an invalid id; the report is ignored"
    fi
  fi
  # The free-text fields are all-or-nothing: a value that does not decode,
  # that decodes to a control character or that is over the spec's limit
  # discards the whole report. Keeping the state and dropping only the text
  # would publish a claim the program never made.
  if ! osc_title_text=$(osc_decode "$osc_title" $OSC_MAX_TITLE_ENC $OSC_MAX_TITLE_DEC); then
    fail "the --osc-fd body has a broken title; the report is discarded"
  fi
  if ! osc_msg_text=$(osc_decode "$osc_msg" $OSC_MAX_MSG_ENC $OSC_MAX_MSG_DEC); then
    fail "the --osc-fd body has a broken msg; the report is discarded"
  fi
  # An unknown kind and a progress that is not an integer in 0..100 are
  # absent: the spec says so, and they do not invalidate the rest of the
  # report. An app that does not fit is absent for the same reason — it is a
  # hint about which program is reporting, not the report itself.
  case "$osc_kind" in
  permission | question | auth) ;;
  *) osc_kind="" ;;
  esac
  [[ $osc_progress =~ ^([0-9]|[1-9][0-9]|100)$ ]] || osc_progress=""
  if [[ -n $osc_app ]] && { ((${#osc_app} > OSC_MAX_APP)) ||
    [[ ! $osc_app =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]]; }; then
    osc_app=""
  fi

  # ---------------------------------------------------------- 3. apply
  # An id-less report is the root record, which is one per terminal. Without
  # a terminal id or an explicit session there is no stable scope, and two
  # writers would share one root file. Refuse that instead of inventing a
  # collision; the tap always supplies both.
  if [[ -n $osc_fd && -z $osc_id && -z $terminal_id && -z $session ]]; then
    fail "an id-less --osc-fd report needs --terminal-id or --session"
  fi
  # Explicit options win; the body fills only what was not given.
  [[ -n $agent ]] || agent=$osc_app
  # A protocol id may contain `/` (build/test); the record file name must not,
  # so it is sanitized here and the raw id is kept in recordId below.
  [[ -n $session ]] || session=$(osc_session "$osc_id")
  [[ -n $record_id ]] || record_id=$osc_id
  [[ -n $name ]] || name=$osc_title_text
  [[ -n $message ]] || message=$osc_msg_text
  [[ -n $kind ]] || kind=$osc_kind
  [[ -n $progress ]] || progress=$osc_progress
  [[ -n $state ]] || state=$osc_state
fi

# The default state belongs to a plain command line call. A report that
# arrived on a descriptor has already been refused above when it carried no
# state, so the default never invents a run that never started.
[[ -n $state ]] || state=working

[[ -n $agent ]] || fail "--agent is required (or app= in the --osc-fd body)"
[[ -n $session ]] || fail "--session is required (or id= in the --osc-fd body)"
case "$state" in
working | blocked | done | error | idle | unknown | clear) ;;
*) fail "--state must be working, blocked, done, error, idle, unknown, or clear" ;;
esac
case "$kind" in
"" | permission | question | auth) ;;
*) fail "--kind must be permission, question, or auth" ;;
esac
[[ -z $progress || $progress =~ ^([0-9]|[1-9][0-9]|100)$ ]] ||
  fail "--progress must be an integer 0..100"
[[ -z $record_id || $record_id =~ ^[A-Za-z0-9_.+-]{1,32}(/[A-Za-z0-9_.+-]{1,32}){0,7}$ ]] ||
  fail "--record-id must be a protocol id: segments of [A-Za-z0-9_.+-], at most 8 levels"

# `--agent` and `--session` name the record file. They are ids, not text, and
# are held to a plain charset: that keeps free text out of this process's argv
# entirely, so the descriptor options below are the only way any user content
# can enter the script.
[[ $agent =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] ||
  fail "--agent must be an id: letters, digits, dot, dash, underscore (max 64)"
[[ $session =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] ||
  fail "--session must be an id: letters, digits, dot, dash, underscore (max 64)"
[[ $state =~ ^[a-z]+$ ]] || fail "--state is not a known state word"
[[ $herdr_pane =~ ^[A-Za-z0-9:_.-]{0,64}$ ]] ||
  fail "--herdr-pane must be a plain pane id of at most 64 characters"
# A tmux pane id is always '%' + digits, but the field is absent outside tmux,
# so empty is allowed and only a non-empty value must match. Unlike the pane,
# the socket is only a hint: it points tmux at the right server, and a value
# that is not a plain absolute path is dropped rather than failing the write,
# so the pane still focuses against the default server instead of losing the
# whole record.
[[ -z $tmux_pane || $tmux_pane =~ ^%[0-9]{1,6}$ ]] ||
  fail "--tmux-pane must be empty or a pane id like %3"
if [[ -n $tmux_socket ]]; then
  # An absolute path made of plain segments, no `.`/`..`/empty segment: the
  # socket is passed to tmux as data, but a traversal path still selects an
  # arbitrary socket.
  [[ $tmux_socket =~ ^/[A-Za-z0-9._/-]{1,255}$ ]] &&
    [[ $tmux_socket != *"/../"* && $tmux_socket != */.. &&
       $tmux_socket != *"/./"* && $tmux_socket != */. &&
       $tmux_socket != *"//"* ]] || tmux_socket=""
fi
# `--pid` reaches bash arithmetic in resolve_window, and arithmetic recursively
# evaluates its input, so a non-numeric value is command execution:
#   --pid 'i[$(id)]'  runs `id`
# `set -u` does not prevent that because the array names used there are defined
# locals. A number is the only accepted value.
[[ $pid =~ ^[0-9]{1,10}$ ]] || fail "--pid must be a number of at most 10 digits"
# `--window` is stored in the record and later handed to hyprctl, so it is
# either one of the two keywords or a plain address — never free text.
[[ $window =~ ^(auto|none|0x[0-9a-fA-F]{1,16})$ ]] ||
  fail "--window must be auto, none, or a window address like 0x5591a…"
# Every stored field is capped so one record can never exceed the reader's cap
# and the shell never holds an unbounded value. The title and the message
# carry the spec's own limits (192 and 2048 decoded bytes), so a conforming
# report is never cut short; the reader may still show less of it.
name=${name:0:192}
message=${message:0:2048}
cwd=${cwd:0:1024}

[[ -n $prompt_fd ]] && prompt=$(read_fd "$prompt_fd" 240)
[[ -n $message_fd ]] && message=$(read_fd "$message_fd" 2048)
[[ -n $name_fd ]] && name=$(read_fd "$name_fd" 192)
[[ -n $cwd_fd ]] && cwd=$(read_fd "$cwd_fd" 1024)

# C0/C1 control bytes (plus the bidi/format code points) are stripped at
# write time, matching Model.js's printable(). tr removes C0 and DEL safely;
# sed removes the UTF-8-encoded C1 and format ranges as whole sequences —
# a byte-range tr over 0x7f-0x9f would also eat the continuation bytes of
# ordinary multi-byte text (文 is e6 96 87) and corrupt it.
strip_control() {
  printf '%s' "$1" | tr -d '\000-\037\177' | LC_ALL=C sed \
    -e 's/\xc2[\x80-\x9f]//g' \
    -e 's/\xe2\x80[\x8b-\x8f\xaa-\xae]//g' \
    -e 's/\xe2\x81[\xa6-\xa9]//g' \
    -e 's/\xd8\x9c//g' \
    -e 's/\xef\xbb\xbf//g'
}
[[ -n $prompt ]] && prompt=$(strip_control "$prompt")
[[ -n $message ]] && message=$(strip_control "$message")
[[ -n $name ]] && name=$(strip_control "$name")
[[ -n $cwd ]] && cwd=$(strip_control "$cwd")
# ------------------------------------------------------------- state paths

# A record is at most this large; the reader in Record.qml enforces the same
# cap, and muster-report refuses to read a larger one back.
MAX_RECORD_BYTES=65536

# Read an existing record the way Record.qml does: never a symlink, never a
# special file, never more than the cap. A same-user writer chooses the file's
# contents and could point the path elsewhere, so the read must not follow a
# link, wait on a special file, or allocate without bound.
read_record() {
  local f="$1" size
  [[ -f $f && ! -L $f && -O $f ]] || return 0
  size=$(stat -c %s -- "$f" 2>/dev/null) || return 0
  [[ $size =~ ^[0-9]+$ && $size -le $MAX_RECORD_BYTES ]] || return 0
  dd if="$f" iflag=nofollow,nonblock bs="$MAX_RECORD_BYTES" count=1 status=none 2>/dev/null || true
}

state_base="${XDG_STATE_HOME:-$HOME/.local/state}"
# XDG requires an absolute path. A relative one would silently relocate the
# records next to wherever the caller happens to be, and one starting with "-"
# would be parsed as an option by mktemp and friends below.
[[ $state_base == /* ]] ||
  fail "XDG_STATE_HOME must be an absolute path (got: $state_base)"
# A trailing slash is trimmed, but an all-slash value stays "/": stripping it
# would turn the state home into a relative path, or into an empty one the
# checks below reject.
[[ $state_base =~ ^/+$ ]] || state_base="${state_base%/}"
state_dir="$state_base/omarchy/muster/sessions"

# Every component this plugin creates under the state home must be a real
# directory owned by this user. mkdir -p, chmod and every later open follow a
# symlinked component, so a same-user writer that drops a link at
# …/omarchy/muster would otherwise move the whole sessions directory — records
# included — somewhere else. The state home itself is left alone: a user who
# symlinks XDG_STATE_HOME into a dotfiles repo did that on purpose.
require_owned_chain() {
  local rest="${1#"$state_base"/}" part path="$state_base"
  local -a parts=()
  # Word splitting is wanted here and only here: the components of the path.
  # IFS is scoped to this one read, never set globally, and noglob keeps a
  # component that looks like a pattern from expanding to filenames.
  set -f
  IFS=/ read -r -a parts <<<"$rest" || true
  set +f
  for part in "${parts[@]}"; do
    [[ -n $part ]] || continue
    path="$path/$part"
    [[ ! -L $path ]] || fail "$path is a symlink; refusing"
    if [[ -e $path ]]; then
      [[ -d $path ]] || fail "$path is not a directory"
      [[ -O $path ]] || fail "$path is not owned by this user"
    fi
  done
}

require_owned_chain "$state_dir"
mkdir -p "$state_dir" 2>/dev/null || fail "cannot create $state_dir"
# Re-checked after the creation: the components were validated before mkdir
# ran, and a same-user writer can swap one in between.
require_owned_chain "$state_dir"
[[ -d $state_dir && ! -L $state_dir && -O $state_dir ]] ||
  fail "$state_dir is not a directory owned by this user"

# `~` cannot appear in a sanitised component (sanitize maps everything outside
# [a-zA-Z0-9._-] to `_`), so the join is unambiguous: `a-b` + `c` and `a` +
# `b-c` no longer both publish to `a-b-c.json`.
record_name="$(sanitize "$agent")~$(sanitize "$session").json"
file="$state_dir/$record_name"
# Once lock_dir holds its descriptor, every read and write addresses the record
# through that descriptor rather than through the path: /proc/self/fd/N/<name> resolves
# to the very inode that was vetted, so a same-user writer that renames the
# directory — or swaps a symlink in at any component — between the checks and
# the write cannot redirect it. `dir_ref` is empty until the lock is held.
dir_ref=""

# Open the sessions directory read-only and lock it. There is no predictable
# lock file to truncate and no symlink to follow, and the opened descriptor is
# re-checked against the path so a directory swapped in after the checks cannot
# redirect the lock. -w bounds the wait so one stuck writer cannot block every
# other integration forever.
lock_dir() {
  # A fresh descriptor, not a fixed number: `exec 9<` used to replace a
  # caller's --emit-osc 9, and any fixed number can collide with a caller's
  # descriptor or a low RLIMIT_NOFILE.
  local lock_fd
  exec {lock_fd}<"$state_dir" || fail "cannot open $state_dir"
  dir_ref="/proc/$$/fd/$lock_fd"
  flock -w 5 -x "$lock_fd" || fail "cannot lock $state_dir"
  # Re-vet the path AFTER the open: a symlinked component planted between the
  # earlier check and this open would otherwise be followed, and the identity
  # check below alone cannot see it (stat follows the link too). The fd identity
  # check then catches a swap-back between this re-check and the open.
  require_owned_chain "$state_dir"
  [[ -d /proc/$$/fd/$lock_fd ]] || fail "$state_dir is not a directory"
  local fd_id path_id
  fd_id=$(stat -Lc '%d:%i' "/proc/$$/fd/$lock_fd" 2>/dev/null || true)
  path_id=$(stat -c '%d:%i' -- "$state_dir" 2>/dev/null || true)
  [[ -n $fd_id && $fd_id == "$path_id" ]] || fail "$state_dir changed while it was being locked"
}

# ------------------------------------------------------------- OSC 7501 out

# Write the report to a terminal as an OSC 7501 sequence. Best effort only: a
# report must never fail the writer because a hook had no controlling tty. The
# sequence is a fixed state, a validated id/list, and base64 — nothing that can
# break out of the escape, and `printf` is a builtin fed by a variable, so no
# shell source is built from it.
b64() { printf '%s' "$1" | base64 -w0 2>/dev/null || true; }

emit_report() {
  [[ -n $emit_osc ]] || return 0
  local seq
  if [[ $state == clear ]]; then
    # A clear is a command, not a state: it removes the addressed record, so
    # it carries the address and nothing else.
    seq="state=clear:app=$agent"
    [[ -n $record_id ]] && seq+=":id=$record_id"
  else
    case "$state" in
    idle | working | done | blocked | error) ;;
    *) return 0 ;;
    esac
    seq="state=$state"
    # kind and progress describe a run that is in flight. A settled report
    # (done, error) has no run left, and a cleared one has no record at all,
    # so a stale kind or progress would be a claim about nothing.
    if [[ $state == working || $state == blocked ]]; then
      [[ -n $kind ]] && seq+=":kind=$kind"
      [[ -n $progress ]] && seq+=":progress=$progress"
    fi
    seq+=":app=$agent"
    local title_b64 msg_b64
    title_b64=$(b64 "$name")
    msg_b64=$(b64 "$message")
    [[ -n $title_b64 ]] && seq+=":title=$title_b64"
    [[ -n $msg_b64 ]] && seq+=":msg=$msg_b64"
    [[ -n $record_id ]] && seq+=":id=$record_id"
  fi
  if [[ $emit_osc == tty ]]; then
    { printf '\033]7501;%s\033\\' "$seq" >/dev/tty; } 2>/dev/null || true
  else
    { printf '\033]7501;%s\033\\' "$seq" >&"$emit_osc"; } 2>/dev/null || true
  fi
}

if ((remove)) || [[ $state == clear ]]; then
  # A removal is a clear: the consumer has to see the record go away, so the
  # emitted sequence says `state=clear` and never the default working.
  state=clear
  lock_dir
  # The wire address is the protocol id, not the record's file name. When the
  # caller did not supply --record-id, recover it from the record being
  # removed; otherwise a terminal consumer would clear the app's root record
  # while a different record disappeared from disk.
  if [[ -z $record_id ]]; then
    old_remove=$(read_record "$dir_ref/$record_name")
    record_id=$(jq -r 'if type == "object" then (.recordId // "") else "" end' \
      <<<"${old_remove:-{}}" 2>/dev/null || true)
    if ((${#record_id} > 263)) ||
      [[ ! $record_id =~ ^[A-Za-z0-9_.+-]{1,32}(/[A-Za-z0-9_.+-]{1,32}){0,7}$ ]]; then
      record_id=""
    fi
  fi
  # A --remove of an arbitrary file cannot be expressed on the wire: an
  # id-less clear would delete the app's root record instead. Suppress the
  # emission in that case; a root record (session "root"/"root-...") and an
  # explicit --state clear still emit. The tap uses --state clear for a root
  # removal, so its wire stays in step.
  if ((remove)) && [[ -z $record_id ]] && [[ $session != root && $session != root-* ]]; then
    emit_osc=""
  fi
  emit_report
  # Through the descriptor lock_dir just opened, not through the path.
  rm -f -- "$dir_ref/$record_name"
  exit 0
fi


# ------------------------------------------------------------- window id
#
# Walk our own parent chain and match it against the compositor's window list:
# hyprctl reports the pid of the process that owns each window, normally the
# terminal emulator.

resolve_window() {
  local current="$1" stat chain=() i
  for ((i = 0; i < 16; i++)); do
    # Validate before any arithmetic: `(( ))` evaluates its input, so a
    # non-numeric value must never reach it.
    [[ $current =~ ^[0-9]+$ && $current -gt 1 ]] || break
    chain+=("$current")
    stat=$(cat "/proc/$current/stat" 2>/dev/null) || break
    current=$(awk '{print $2}' <<<"${stat##*)}")
    [[ $current =~ ^[0-9]+$ ]] || break
  done
  (( ${#chain[@]} > 0 )) || return 0
  local clients
  clients=$(timeout 2 hyprctl -j clients 2>/dev/null) || return 0

  # One jq for the whole chain, in chain order (nearest ancestor first).
  # The old loop ran two jq processes per ancestor: up to 32 forks for a
  # lookup that costs one.
  local IFS=,
  local chain_json="[${chain[*]}]"
  local matches count
  matches=$(jq -c --argjson chain "$chain_json" \
    'first($chain[] as $p | [.[] | select(.pid == $p)] | select(length > 0)) // []' \
    <<<"$clients" 2>/dev/null)
  [[ -n $matches ]] || matches='[]'
  count=$(jq 'length' <<<"$matches" 2>/dev/null)
  [[ $count =~ ^[0-9]+$ ]] || count=0
  if ((count == 0)); then
    # A multiplexer pane runs under its own daemon, so no ancestor owns a
    # window: herdr panes are parented to the herdr server, and a tmux pane to
    # the tmux server, whose own client terminal may be gone. The prompt was
    # typed in the client, so the focused window is the one to use.
    [[ -n $herdr_pane || -n $tmux_pane ]] || return 0
    timeout 2 hyprctl -j activewindow 2>/dev/null | jq -r '.address // ""' 2>/dev/null || true
    return 0
  fi

  if ((count == 1)); then
    jq -r '.[0].address' <<<"$matches"
    return 0
  fi

  # A single-instance terminal (ghostty, kitty) reports one pid for every
  # window, so the parent chain cannot tell them apart. Prefer the focused
  # window, then the most recently focused one.
  local focused address
  focused=$(timeout 2 hyprctl -j activewindow 2>/dev/null | jq -r '.address // ""' 2>/dev/null)
  address=$(jq -r --rawfile f <(printf '%s' "$focused") \
    '.[] | select(.address == $f) | .address' <<<"$matches" 2>/dev/null | head -n1)
  if [[ -n $address && $address != null ]]; then
    printf '%s' "$address"
    return 0
  fi
  jq -r 'sort_by(.focusHistoryID // 999999) | .[0].address' <<<"$matches"
}

# ------------------------------------------------------------ read/modify

lock_dir

# The mode is set through the locked descriptor, not through the path: fd N is
# the very inode that lock_dir vetted, and a chmod that goes through the /proc
# magic link acts on that inode, so a rename of the path cannot redirect it. The
# read-back then keeps the promise honest — a filesystem that does not enforce
# POSIX modes (FAT, some FUSE and network mounts) would otherwise leave the
# prompts readable by every local user, and this turns that into a refusal
# instead of a quiet leak.
[[ -d $dir_ref ]] || fail "$state_dir is not a directory"
chmod 700 -- "$dir_ref" 2>/dev/null || true
dir_mode=$(stat -Lc %a -- "$dir_ref" 2>/dev/null) || dir_mode="unknown"
[[ $dir_mode == 700 ]] ||
  fail "$state_dir is mode $dir_mode, not 700; refusing to write records where another user could read them"

old=$(read_record "$dir_ref/$record_name")
# Valid JSON is not enough: the merge below indexes the previous record by
# field name, and a top-level array, string or number would make jq abort with
# a type error. Because `set -e` is active, that aborted the writer before it
# staged anything, so one such file wedged its session forever — every later
# report failed silently and no completion ever alerted. Only an object is a
# record; anything else is treated as no previous record at all.
jq -e 'type == "object"' >/dev/null 2>&1 <<<"$old" || old='{}'

# Resolve the window under the lock and through the vetted descriptor. A tap
# reports the same session many times, so reuse the address already stored for
# this pid; the compositor lookup walks sixteen ancestors and calls hyprctl,
# which costs ~100 ms and serialises every client. The hint is a record field,
# not a trust boundary, but reading it through the locked fd keeps a symlinked parent
# from redirecting the read. The address is re-validated below and in Model.js.
window_address=""
case "$window" in
none) ;;
auto)
  hint_window=$(jq -r --argjson pid "$pid" \
    'if type == "object" and (.pid == $pid) then (.windowAddress // "") else "" end' \
    <<<"$old" 2>/dev/null || true)
  [[ $hint_window =~ ^0x[0-9a-fA-F]{1,16}$ ]] || hint_window=""
  if [[ -n $hint_window ]]; then
    window_address=$hint_window
  else
    window_address=$(resolve_window "$pid" || true)
  fi
  ;;
*) window_address="$window" ;;
esac
# resolve_window returns compositor data read back from hyprctl, and the manual
# value was already held to this regex. Re-check the resolved one too, so the
# single field that rides back into hyprctl can only ever be a plain address.
[[ $window_address =~ ^0x[0-9a-fA-F]{1,16}$ ]] || window_address=""

now=$(date +%s%3N 2>/dev/null)
# +%s%3N is GNU-specific; on a date(1) that prints it literally the writer would
# abort under set -e. Fall back to whole seconds so the timestamp stays numeric.
[[ $now =~ ^[0-9]+$ ]] || now=$(( $(date +%s) * 1000 ))
# Pure shell on purpose: basename(1) is an external process, and the working
# directory would appear on its command line — world-readable through
# /proc/<pid>/cmdline, which is exactly what the descriptor options above
# exist to prevent. Parameter expansion keeps it in this process.
project="${cwd%/}"
project="${project##*/}"
# Capped like the other fields, including the fresh value: only the inherited
# one was capped before.
project=${project:0:256}

# Every string reaches jq through a private descriptor, never through its argv:
# `--rawfile <(printf …)` puts only `/dev/fd/N` in the command line, and jq
# reads the value from the pipe. `--arg name`/`--arg cwd` would put the session
# name, the working directory and the project — all derived from what the user
# typed — into `ps` output for every local user while this runs. Only numbers
# (pid, timestamps, counters) are passed as arguments, and they carry nothing.
merged=$(jq -c \
  --rawfile agent <(printf '%s' "$agent") \
  --rawfile session <(printf '%s' "$session") \
  --rawfile state <(printf '%s' "$state") \
  --rawfile kind <(printf '%s' "$kind") \
  --rawfile progress <(printf '%s' "$progress") \
  --rawfile recordid <(printf '%s' "$record_id") \
  --rawfile terminalid <(printf '%s' "$terminal_id") \
  --rawfile name <(printf '%s' "$name") \
  --rawfile cwd <(printf '%s' "$cwd") \
  --rawfile project <(printf '%s' "$project") \
  --rawfile prompt <(printf '%s' "$prompt") \
  --rawfile message <(printf '%s' "$message") \
  --rawfile window <(printf '%s' "$window_address") \
  --rawfile pane <(printf '%s' "$herdr_pane") \
  --rawfile tmuxpane <(printf '%s' "$tmux_pane") \
  --rawfile tmuxsocket <(printf '%s' "$tmux_socket") \
  --argjson pid "${pid:-0}" \
  --argjson now "$now" \
  --argjson completed "$completed" \
  '
  # The previous record is untrusted input written by same-user code: its
  # counters are taken by type, never by arithmetic on whatever was there, and
  # its inherited strings are re-capped with the same limits the fields are
  # written with, so a near-cap predecessor cannot push the merged record past
  # the 64 KiB the reader accepts and make the session vanish.
  def count: if type == "number" then (if . < 0 or . > 1e15 then 0 else . end) else 0 end;
  def text($cap): if type == "string" then (.[0:$cap]) else "" end;
  (if type == "object" then . else {} end) as $old
  | (($old.state // "") | tostring) as $oldstate
  # A settled report is a finished run: when the record was not already settled,
  # it counts as one completion, so a plain `--state done` triggers the alert
  # without the caller also having to pass --completed.
  | (if ($state == "done" or $state == "error") and $oldstate != "done" and $oldstate != "error" then 1 else 0 end) as $settled
  | {
      schemaVersion: 2,
      agent: $agent,
      sessionId: $session,
      name: (if $name != "" then $name else ($old.name | text(192)) end),
      cwd: (if $cwd != "" then $cwd else ($old.cwd | text(1024)) end),
      project: (if $project != "" then $project else ($old.project | text(256)) end),
      state: $state,
      kind: (if $state == "blocked" then $kind else "" end),
      progress: (if ($state == "working" or $state == "blocked") and $progress != ""
        then (($progress | tonumber?) // -1) else -1 end),
      recordId: (if $recordid != "" then $recordid else ($old.recordId | text(263)) end),
      # The terminal id names the pty (or the tap) that owns this record. Like
      # the multiplexer pane it is a stable property of the session: a report
      # from a hook that does not know the terminal must not erase one that
      # is already known, or the record would fall back to the old pid key and
      # split into another session.
      terminalId: (if $terminalid != "" then $terminalid else ($old.terminalId | text(64)) end),
      message: (if ($state == "blocked" or $state == "done" or $state == "error")
        then (if $message != "" then $message else ($old.message | text(2048)) end)
        else "" end),
      lastPrompt: (if $prompt != "" then $prompt else ($old.lastPrompt | text(240)) end),
      pid: $pid,
      windowAddress: $window,
      # A multiplexer pane is a stable property of the session: the pane does
      # not change while the process lives. So an absent value must not erase
      # one already known — a report from a hook that does not inherit the
      # multiplexer environment would otherwise drop the target and the click
      # would stop jumping. windowAddress stays overwrite-only: a compositor
      # address can be reused after its window closes, so an inherited one is
      # not safe to keep. The reader re-validates every inherited value.
      herdrPane: (if $pane != "" then $pane else ($old.herdrPane | text(64)) end),
      tmuxPane: (if $tmuxpane != "" then $tmuxpane else ($old.tmuxPane | text(64)) end),
      tmuxSocket: (if $tmuxsocket != "" then $tmuxsocket else ($old.tmuxSocket | text(256)) end),
      updatedAt: $now,
      completedRuns: (($old.completedRuns | count) + $completed + $settled),
      seq: (($old.seq | count) + 1)
    }
  ' <<<"$old")
# The merge inherits strings from the previous record. jq only caps them; the
# writer already has a byte-level control/bidi stripper, so apply it once to
# the whole compact JSON before anything is published or printed with --json.
merged=$(strip_control "$merged")

# The destination is always a directory entry, never a target: a symlink or a
# special file left at the path is removed first and then replaced by the
# atomic rename. A directory is refused (never deleted). This keeps one stale
# symlink from wedging a session forever, while mv -T still refuses to follow
# a link into a directory.
if [[ -L $dir_ref/$record_name ]]; then
  rm -f -- "$dir_ref/$record_name"
fi
[[ ! -d $dir_ref/$record_name ]] || fail "$file exists and is a directory"

# The merged record must still fit the reader's cap. Every field above is
# bounded, so this is a backstop: a record the reader would refuse is never
# published in the first place.
merged_bytes=$(printf '%s' "$merged" | wc -c)
[[ $merged_bytes -le $MAX_RECORD_BYTES ]] ||
  fail "the merged record is $merged_bytes bytes, over the $MAX_RECORD_BYTES the reader accepts"

# The staging file is created by the same open that writes it, with O_EXCL
# (`conv=excl`): a name that already exists — including one pre-created as a
# hardlink — makes the open fail instead of being followed or truncated.
# mktemp followed by a separate redirect-by-name leaves a window between
# creating the name and writing to it, and O_NOFOLLOW does not close it, because
# a hardlink is not a symlink. umask 077 means the file is born 0600, so nothing
# chmods a path afterwards (a chmod by name is the same window), and the rename
# only ever moves a directory entry.
rand=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n') ||
  fail "cannot read randomness"
[[ -n $rand ]] || fail "cannot create a staging name"
# The trap goes in before the first create, not after: a failure between the
# open and the trap used to leave a .muster.* staging file behind until the
# hourly prune. The guarded expansion keeps the trap safe when nothing was
# created yet.
staging=""
trap '[[ -n ${staging:-} ]] && rm -f -- "$staging"' EXIT
attempt=0
for attempt in 1 2 3 4 5; do
  cand="$dir_ref/.muster.$rand.$attempt"
  if printf '%s' "$merged" | dd of="$cand" conv=excl status=none 2>/dev/null; then
    staging="$cand"
    break
  fi
done
[[ -n $staging ]] || fail "cannot create a staging file in $state_dir"
# The staged record is verified before it is published: a filesystem that
# ignores the mode would otherwise put the prompt somewhere other users can
# read. mktemp already creates it 0600 under umask 077; this checks the result.
staging_mode=$(stat -c %a -- "$staging" 2>/dev/null) || staging_mode="unknown"
[[ $staging_mode == 600 ]] ||
  fail "the staged record is mode $staging_mode, not 600; refusing to publish it"
# -T: the destination is always treated as a file, so a symlink planted at the
# record path is replaced rather than followed into a directory.
mv -T -f -- "$staging" "$dir_ref/$record_name"
staging=""

# The record is published; only now mirror it to the terminal, so a consumer
# never sees a report the record writer refused.
emit_report

((print_json)) && printf '%s\n' "$merged"
exit 0
