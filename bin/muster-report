#!/bin/bash

# Writer for the shienze.muster shell plugin, for every agent that is not
# pi. Any integration can call this to publish a session record; the plugin
# watches the sessions directory and never talks to the agent itself.
#
#   # a run started — the prompt arrives on stdin, never as an argument
#   printf '%s' "$PROMPT" | muster-report --agent claude --session "$ID" \
#     --state working --name "Refactor auth" --cwd "$PWD" --prompt-fd 0
#
#   # a run finished (this is what triggers the sound + notification)
#   muster-report --agent claude --session "$ID" --state idle --completed
#
#   # waiting on the user
#   printf '%s' "approve the patch" | muster-report --agent claude --session "$ID" \
#     --state blocked --message-fd 0
#
#   # gone
#   muster-report --agent claude --session "$ID" --remove
#
# `--agent` takes any id omarchy ships (pi, omp, opencode, claude, codex, crush,
# grok, gemini, openclaw, hermes, copilot, muse, cursor-agent) plus their
# aliases; an unknown id still works and gets the generic mark.

set -euo pipefail

# A record carries the last user prompt and the working directory, so nothing
# this script creates may be readable by another local user. umask 077 makes
# the record, its lock and its temp file owner-only; the chmods below also
# repair a directory or record left behind world-readable by an older version.
umask 077

usage() {
  cat <<'USAGE'
Usage: muster-report --agent <id> --session <id> [options]

  --state <working|blocked|idle|unknown>  Session state (default: working)
  --name <text>        Display name for the session
  --cwd <path>         Working directory (default: $PWD)
  --prompt-fd <n>      Read the last prompt from descriptor n (never argv)
  --message-fd <n>     Read the blocked detail from descriptor n (never argv)
  --pid <n>            Owning process id (default: $PPID)
  --window <value>     Hyprland window address, "auto" (default) or "none"
  --herdr-pane <id>    herdr pane to focus (default: $HERDR_PANE_ID when in herdr)
  --completed          Increment completedRuns: a run just settled
  --remove             Delete the record and exit
  --json               Print the resulting record
  -h, --help           This text

Environment:
  XDG_STATE_HOME       Defaults to ~/.local/state
  HERDR_PANE_ID        Picked up as --herdr-pane when HERDR_ENV=1
USAGE
}

fail() {
  echo "muster-report: $*" >&2
  exit 1
}

agent=""
session=""
state="working"
name=""
cwd="$PWD"
prompt=""
message=""
prompt_fd=""
message_fd=""
pid="$PPID"
window="auto"
herdr_pane=""
[[ ${HERDR_ENV:-} == "1" ]] && herdr_pane="${HERDR_PANE_ID:-}"
completed=0
remove=0
print_json=0

while (($# > 0)); do
  case "$1" in
  --agent) agent="${2:-}"; shift 2 ;;
  --session) session="${2:-}"; shift 2 ;;
  --state) state="${2:-}"; shift 2 ;;
  --name) name="${2:-}"; shift 2 ;;
  --cwd) cwd="${2:-}"; shift 2 ;;
  --prompt-fd) prompt_fd="${2:-}"; shift 2 ;;
  --message-fd) message_fd="${2:-}"; shift 2 ;;
  --prompt | --message)
    fail "$1 puts user text on the process command line; pipe it to --prompt-fd/--message-fd instead" ;;
  --pid) pid="${2:-}"; shift 2 ;;
  --window) window="${2:-}"; shift 2 ;;
  --herdr-pane) herdr_pane="${2:-}"; shift 2 ;;
  --completed) completed=1; shift ;;
  --remove) remove=1; shift ;;
  --json) print_json=1; shift ;;
  -h | --help) usage; exit 0 ;;
  *) fail "unknown option: $1" ;;
  esac
done

[[ -n $agent ]] || fail "--agent is required"
[[ -n $session ]] || fail "--session is required"
case "$state" in
working | blocked | idle | unknown) ;;
*) fail "--state must be working, blocked, idle, or unknown" ;;
esac

[[ -z $herdr_pane || $herdr_pane =~ ^[A-Za-z0-9:_.-]+$ ]] ||
  fail "--herdr-pane must be a plain pane id"

# The prompt and the blocked detail are user text, so they never travel as
# arguments: a process's argv is world-readable through /proc/<pid>/cmdline
# while it runs, and no file mode can protect a value handed over that way.
# They arrive on a file descriptor instead —
#   printf '%s' "$PROMPT" | muster-report ... --prompt-fd 0
# `IFS=` keeps leading and trailing whitespace, `-d ''` reads to end of file,
# and `read` is a shell builtin, so no child process ever sees the value.
read_fd() {
  local fd="$1" value=""
  IFS= read -r -d '' value <&"$fd" || true
  printf '%s' "$value"
}

[[ -z $prompt_fd || $prompt_fd =~ ^[0-9]+$ ]] ||
  fail "--prompt-fd must be a descriptor number"
[[ -z $message_fd || $message_fd =~ ^[0-9]+$ ]] ||
  fail "--message-fd must be a descriptor number"
[[ -n $prompt_fd ]] && prompt=$(read_fd "$prompt_fd")
[[ -n $message_fd ]] && message=$(read_fd "$message_fd")

sanitize() { printf '%s' "$1" | tr -c 'a-zA-Z0-9._-' '_' | cut -c1-80; }

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/muster/sessions"
mkdir -p "$state_dir"
chmod 700 "$state_dir" 2>/dev/null || true
file="$state_dir/$(sanitize "$agent")-$(sanitize "$session").json"

if ((remove)); then
  rm -f "$file" "$file.lock"
  exit 0
fi

# ------------------------------------------------------------- window id
#
# Walk our own parent chain and match it against the compositor's window list:
# hyprctl reports the pid of the process that owns each window, normally the
# terminal emulator.

resolve_window() {
  local current="$1" stat chain=() i
  for ((i = 0; i < 16; i++)); do
    ((current > 1)) || break
    chain+=("$current")
    stat=$(cat "/proc/$current/stat" 2>/dev/null) || break
    current=$(awk '{print $2}' <<<"${stat##*)}")
    [[ $current =~ ^[0-9]+$ ]] || break
  done
  (( ${#chain[@]} > 0 )) || return 0
  local clients
  clients=$(hyprctl -j clients 2>/dev/null) || return 0

  local pid matches="" count=0
  for pid in "${chain[@]}"; do
    matches=$(jq -c --argjson pid "$pid" '[.[] | select(.pid == $pid)]' <<<"$clients" 2>/dev/null)
    count=$(jq 'length' <<<"${matches:-[]}" 2>/dev/null)
    [[ $count =~ ^[0-9]+$ ]] || count=0
    ((count > 0)) && break
    matches=""
  done
  if ((count == 0)); then
    # herdr runs its panes under a daemon, so no ancestor owns a window. The
    # report comes from the herdr UI, so the focused window is the one to use.
    [[ -n $herdr_pane ]] || return 0
    hyprctl -j activewindow 2>/dev/null | jq -r '.address // ""' 2>/dev/null || true
    return 0
  fi

  if ((count == 1)); then
    jq -r '.[0].address' <<<"$matches"
    return 0
  fi

  # A single-instance terminal (ghostty, kitty) reports one pid for every
  # window, so the parent chain cannot tell them apart. Prefer the focused
  # window, then the most recently focused one.
  local focused address
  focused=$(hyprctl -j activewindow 2>/dev/null | jq -r '.address // ""' 2>/dev/null)
  address=$(jq -r --arg f "$focused" '.[] | select(.address == $f) | .address' <<<"$matches" 2>/dev/null | head -n1)
  if [[ -n $address && $address != null ]]; then
    printf '%s' "$address"
    return 0
  fi
  jq -r 'sort_by(.focusHistoryID // 999999) | .[0].address' <<<"$matches"
}

window_address=""
case "$window" in
none) ;;
auto) window_address=$(resolve_window "$pid" || true) ;;
*) window_address="$window" ;;
esac

# ------------------------------------------------------------ read/modify

exec 9>"$file.lock"
flock -x 9

if [[ -f $file ]]; then
  old=$(<"$file")
  jq -e . >/dev/null 2>&1 <<<"$old" || old='{}'
else
  old='{}'
fi

now=$(date +%s%3N)
project=$(basename "${cwd%/}")

merged=$(jq -c \
  --arg agent "$agent" \
  --arg session "$session" \
  --arg state "$state" \
  --arg name "$name" \
  --arg cwd "$cwd" \
  --arg project "$project" \
  --rawfile prompt <(printf '%s' "$prompt") \
  --rawfile message <(printf '%s' "$message") \
  --argjson pid "${pid:-0}" \
  --arg window "$window_address" \
  --arg herdrPane "$herdr_pane" \
  --argjson now "$now" \
  --argjson completed "$completed" \
  '
  . as $old
  | {
      schemaVersion: 1,
      agent: $agent,
      sessionId: $session,
      name: (if $name != "" then $name else ($old.name // "") end),
      cwd: (if $cwd != "" then $cwd else ($old.cwd // "") end),
      project: (if $project != "" then $project else ($old.project // "") end),
      state: $state,
      message: (if $state == "blocked" then $message else "" end),
      lastPrompt: (if $prompt != "" then $prompt else ($old.lastPrompt // "") end),
      pid: $pid,
      windowAddress: $window,
      herdrPane: $herdrPane,
      updatedAt: $now,
      completedRuns: (($old.completedRuns // 0) + $completed),
      seq: (($old.seq // 0) + 1)
    }
  ' <<<"$old")

printf '%s' "$merged" >"$file.tmp"
chmod 600 "$file.tmp" 2>/dev/null || true
mv -f "$file.tmp" "$file"

((print_json)) && printf '%s\n' "$merged"
exit 0
